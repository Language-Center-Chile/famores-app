<div
    class="bg-white rounded-2xl p-6 shadow-sm border border-stone-100 opacity-50 pointer-events-none smooth-transition"
    id="section-envio"
>
    <h3 class="text-lg font-semibold mb-4 text-terapia-text">
        <span
            class="bg-terapia-sage text-white rounded-full w-6 h-6 inline-flex items-center justify-center text-sm mr-2"
            >2</span
        > Modalidad de Entrega
    </h3>

    <p id="aviso-elige-set" class="text-sm text-terapia-sage font-medium mb-4">
        Debes elegir un set o producto antes de elegir la modalidad de entrega.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <button
            type="button"
            class="option-card shipping-card smooth-transition rounded-xl p-4 text-center relative"
            id="card-blue"
            onclick="selectShipping('blue')"
            aria-pressed="false"
        >
            <div class="absolute top-2 right-2 selected-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <i class="fa-solid fa-box-open text-2xl text-terapia-sage mb-2" aria-hidden="true"></i>
            <h4 class="font-semibold">Blue Express</h4>
            <p class="text-xs text-gray-500 mt-1">Tarifa calculada según región y comuna.</p>
        </button>

        <button
            type="button"
            class="option-card shipping-card smooth-transition rounded-xl p-4 text-center relative"
            id="card-starken"
            onclick="selectShipping('starken')"
            aria-pressed="false"
        >
            <div class="absolute top-2 right-2 selected-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <i class="fa-solid fa-truck-fast text-2xl text-terapia-sage mb-2" aria-hidden="true"></i>
            <h4 class="font-semibold">Starken</h4>
            <p class="text-xs text-gray-500 mt-1">Tarifa calculada según región y comuna.</p>
        </button>

        <button
            type="button"
            class="option-card shipping-card smooth-transition rounded-xl p-4 text-center relative"
            id="card-chilexpress"
            onclick="selectShipping('chilexpress')"
            aria-pressed="false"
        >
            <div class="absolute top-2 right-2 selected-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <i class="fa-solid fa-box text-2xl text-terapia-sage mb-2" aria-hidden="true"></i>
            <h4 class="font-semibold">Chilexpress</h4>
            <p class="text-xs text-gray-500 mt-1">Tarifa calculada según región y comuna.</p>
        </button>

        <button
            type="button"
            class="option-card shipping-card smooth-transition rounded-xl p-4 text-center relative"
            id="card-retiro"
            onclick="selectShipping('retiro')"
            aria-pressed="false"
        >
            <div class="absolute top-2 right-2 selected-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <i class="fa-solid fa-handshake text-2xl text-terapia-sage mb-2" aria-hidden="true"></i>
            <h4 class="font-semibold">Retiro Presencial</h4>
            <p class="text-xs text-gray-500 mt-1">Gratis en Avenida Egaña 1638-B, Peñalolén.</p>
        </button>

        <button
            type="button"
            class="option-card shipping-card smooth-transition rounded-xl p-4 text-center relative"
            id="card-internacional"
            onclick="selectShipping('internacional')"
            aria-pressed="false"
        >
            <div class="absolute top-2 right-2 selected-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <i class="fa-solid fa-globe text-2xl text-terapia-sage mb-2" aria-hidden="true"></i>
            <h4 class="font-semibold">Despacho Internacional</h4>
            <p class="text-xs text-gray-500 mt-1">Se cotiza según país y ciudad.</p>
        </button>
    </div>
</div>

<style>
    button.shipping-card {
        display: block;
        text-align: center;
    }
</style>
