<div
    class="bg-white rounded-2xl p-6 shadow-sm border border-stone-100 opacity-50 pointer-events-none smooth-transition"
    id="section-envio"
>
    <h3 class="text-lg font-semibold mb-4 text-terapia-text">
        <span
            class="bg-terapia-sage text-white rounded-full w-6 h-6 inline-flex items-center justify-center text-sm mr-2"
            >2</span
        > Modalidad de Entrega
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div
            class="option-card smooth-transition rounded-xl p-4 text-center relative"
            id="card-starken"
            onclick="selectShipping('starken')"
        >
            <div class="absolute top-2 right-2 selected-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <i class="fa-solid fa-truck-fast text-2xl text-terapia-sage mb-2"
            ></i>
            <h4 class="font-semibold">Starken</h4>
            <p class="text-xs text-gray-500 mt-1">
                Envío por pagar. Pagas el despacho al recibir.
            </p>
        </div>

        <div
            class="option-card smooth-transition rounded-xl p-4 text-center relative"
            id="card-chilexpress"
            onclick="selectShipping('chilexpress')"
        >
            <div class="absolute top-2 right-2 selected-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <i class="fa-solid fa-box text-2xl text-terapia-sage mb-2"></i>
            <h4 class="font-semibold">Chilexpress</h4>
            <p class="text-xs text-gray-500 mt-1">
                Suma $1.500 de caja. El envío se cobra después.
            </p>
        </div>

        <div
            class="option-card smooth-transition rounded-xl p-4 text-center relative"
            id="card-retiro"
            onclick="selectShipping('retiro')"
        >
            <div class="absolute top-2 right-2 selected-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <i class="fa-solid fa-handshake text-2xl text-terapia-sage mb-2"
            ></i>
            <h4 class="font-semibold">Retiro Presencial</h4>
            <p class="text-xs text-gray-500 mt-1">
                Gratis. Coordinación en Metro Grecia.
            </p>
        </div>
    </div>
</div>
