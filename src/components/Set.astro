---
const setsPrincipales = [
    {
        id: "set-standard-pintado",
        nombre: "Set Standard Pintado",
        precioTexto: "$39.990",
        imagen: "/images/products/set-standard-pintado.webp",
        alt: "Set Standard Pintado de Famores",
        ancho: 1400,
        alto: 1050,
        descripcion: "Set de 14 figuras pintadas a mano, con terminación standard y rostros neutros.",
        contenido: "Incluye 14 figuras en cuatro tamaños.",
        nota: null,
    },
    {
        id: "set-standard-con-expresiones",
        nombre: "Set Standard con Expresiones",
        precioTexto: "$42.990",
        imagen: "/images/products/set-standard-con-expresiones.webp",
        alt: "Set Standard con Expresiones de Famores",
        ancho: 1440,
        alto: 1168,
        descripcion: "Set de 14 figuras pintadas a mano con expresiones faciales que amplían las posibilidades de representación.",
        contenido: "Incluye 14 figuras en cuatro tamaños.",
        nota: null,
    },
    {
        id: "set-sin-pintar",
        nombre: "Set Sin Pintar",
        precioTexto: "$25.000",
        imagen: "/images/products/set-sin-pintar-1.jpg",
        alt: "Set Sin Pintar de Famores",
        ancho: 1440,
        alto: 1080,
        descripcion: "Set de 14 figuras en madera natural, preparado para pintar, intervenir o utilizar sin terminación de color.",
        contenido: "Incluye 14 figuras en cuatro tamaños.",
        nota: null,
    },
    {
        id: "set-personalizado",
        nombre: "Set Personalizado",
        precioTexto: "$45.000",
        imagen: "/images/products/set-personalizado-aymara.webp",
        alt: "Set Personalizado de Famores",
        ancho: 899,
        alto: 899,
        descripcion: "Set de 14 figuras elaborado a pedido, basado en una fotografía familiar, la representación de un pueblo originario o características específicas solicitadas por el cliente.",
        contenido: "Mantiene siempre las 14 figuras y sus cuatro tamaños.",
        nota: "Imagen referencial. El diseño se desarrolla según la solicitud del cliente.",
    },
];

const mascotas = [
    {
        id: "mascota-pintada",
        nombre: "Mascota Pintada",
        precioTexto: "$4.500",
        imagen: "/images/products/mascota-pintada-2.jpg",
        alt: "Mascota Pintada de Famores",
        ancho: 1080,
        alto: 810,
        descripcion: "Mascota de madera pintada a mano. Valor por cada unidad.",
    },
    {
        id: "mascota-sin-pintar",
        nombre: "Mascota Sin Pintar",
        precioTexto: "$2.500",
        imagen: "/images/products/mascota-sin-pintar-1.jpg",
        alt: "Mascota Sin Pintar de Famores",
        ancho: 1080,
        alto: 1098,
        descripcion: "Mascota de madera natural, sin pintar. Valor por unidad.",
    },
];
---

<section class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="bg-terapia-sage text-white rounded-full w-6 h-6 inline-flex items-center justify-center text-sm mb-3">1</span>
        <h2 class="text-2xl md:text-3xl font-bold text-terapia-text">Elige tus productos Famores</h2>
        <p class="text-gray-500 mt-3">
            Puedes comprar un set, varios sets, sólo mascotas o combinar productos. En el carrito eliges la cantidad de cada uno.
        </p>
        <a href="/comprar" class="mt-5 inline-flex items-center justify-center gap-2 rounded-xl bg-terapia-sageDark text-white font-semibold py-3 px-5">
            Ver carrito completo <i class="fa-solid fa-cart-shopping text-xs"></i>
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {setsPrincipales.map((producto) => (
            <article class="rounded-2xl bg-white border border-stone-100 shadow-sm text-left flex flex-col overflow-hidden relative h-full">
                <div class="w-full aspect-[4/3] bg-terapia-bg overflow-hidden flex items-center justify-center">
                    <img src={producto.imagen} alt={producto.alt} width={producto.ancho} height={producto.alto} loading="lazy" class="max-w-full max-h-full object-contain" />
                </div>
                <div class="p-5 flex flex-col flex-1">
                    <h3 class="font-semibold text-lg text-terapia-text leading-tight">{producto.nombre}</h3>
                    <p class="text-2xl font-bold text-terapia-sageDark mt-1 mb-2">{producto.precioTexto}</p>
                    <p class="text-sm text-gray-500">{producto.descripcion}</p>
                    <p class="text-xs font-medium text-terapia-wood mt-2">{producto.contenido}</p>
                    <div class="mt-3 min-h-[2.75rem]">
                        {producto.nota && <p class="text-xs italic text-terapia-wood bg-terapia-woodLight/15 rounded-lg px-3 py-2">{producto.nota}</p>}
                    </div>
                    <a href={`/comprar?add=${producto.id}`} class="mt-auto inline-flex items-center justify-center gap-2 w-full rounded-xl bg-terapia-sage text-white font-semibold py-3 px-4 text-sm">
                        Agregar al carrito <i class="fa-solid fa-cart-plus text-xs"></i>
                    </a>
                </div>
            </article>
        ))}
    </div>

    <div class="text-center max-w-xl mx-auto mt-16 mb-8">
        <h3 class="text-xl md:text-2xl font-bold text-terapia-text">Mascotas Famores</h3>
        <p class="text-gray-500 mt-2 text-sm">Son productos independientes: no necesitas comprar un set para llevarlas.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto items-stretch">
        {mascotas.map((producto) => (
            <article class="rounded-2xl bg-white border border-stone-100 shadow-sm text-left flex flex-col overflow-hidden relative">
                <div class="w-full aspect-[4/3] bg-terapia-bg overflow-hidden flex items-center justify-center">
                    <img src={producto.imagen} alt={producto.alt} width={producto.ancho} height={producto.alto} loading="lazy" class="max-w-full max-h-full object-contain" />
                </div>
                <div class="p-5 flex flex-col flex-1">
                    <h4 class="font-semibold text-lg text-terapia-text leading-tight">{producto.nombre}</h4>
                    <p class="text-xl font-bold text-terapia-sageDark mt-1 mb-2">{producto.precioTexto}</p>
                    <p class="text-sm text-gray-500">{producto.descripcion}</p>
                    <a href={`/comprar?add=${producto.id}`} class="mt-4 inline-flex items-center justify-center gap-2 w-full rounded-xl bg-terapia-woodLight/40 text-terapia-wood font-semibold py-2.5 px-4 text-sm">
                        Comprar / agregar <i class="fa-solid fa-cart-plus text-xs"></i>
                    </a>
                </div>
            </article>
        ))}
    </div>
</section>
