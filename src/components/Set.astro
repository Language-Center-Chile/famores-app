---
import { CATALOG } from '../lib/catalog';
const money = (price: number) => '$'+price.toLocaleString('es-CL');
---
<section class="max-w-6xl mx-auto px-4 py-12 md:py-16" aria-labelledby="catalogo-titulo">
  <div class="text-center max-w-2xl mx-auto mb-10">
    <h2 id="catalogo-titulo" class="text-2xl md:text-3xl font-bold text-terapia-text">Catálogo Famores</h2>
    <p class="text-gray-500 mt-3">Sets, kits con caja, mascotas y productos de Atelier Traisy Audrey. Precios finales en pesos chilenos, IVA incluido.</p>
    <a href="/comprar" class="mt-5 inline-flex items-center justify-center rounded-xl bg-terapia-sageDark text-white font-semibold py-3 px-5">Armar mi pedido</a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
    {CATALOG.map(product => (
      <article id={product.slug} class="rounded-2xl bg-white border border-stone-100 shadow-sm text-left flex flex-col overflow-hidden h-full">
        <div class="w-full aspect-[4/3] bg-terapia-bg flex items-center justify-center p-3">
          <img src={product.image} alt={product.name} width={product.width} height={product.height} loading="lazy" class="w-full h-full object-contain" />
        </div>
        <div class="p-5 flex flex-col flex-1">
          <h3 class="font-semibold text-lg text-terapia-text">{product.name}</h3>
          <p class="text-xs text-gray-500 mt-1">{product.code}</p>
          <p class="text-xl font-bold text-terapia-sageDark mt-2">{product.purchasable ? money(product.price) : 'Consultar precio'}</p>
          <p class="text-sm text-gray-600 mt-3">{product.description}</p>
          {product.note && <p class="text-xs text-gray-500 my-3">{product.note}</p>}
          <a href={product.purchasable ? `/comprar?add=${product.slug}` : `https://wa.me/56962052499?text=${encodeURIComponent('Hola, quisiera cotizar '+product.code+' '+product.name)}`} class="mt-auto inline-flex items-center justify-center w-full rounded-xl bg-terapia-sage text-white font-semibold py-3 px-4 text-sm">
            {product.purchasable ? 'Agregar al carrito' : 'Solicitar cotización'}
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
