---
const setsPrincipales = [
    {
        id: "set-standard-pintado",
        nombre: "Set Standard Pintado",
        precio: 39990,
        precioTexto: "$39.990",
        imagen: "/images/products/set-standard-pintado.webp",
        alt: "Set Standard Pintado de Famores",
        ancho: 1400,
        alto: 1050,
        descripcion:
            "Set de 14 figuras pintadas a mano, con terminación standard y rostros neutros.",
        contenido: "Incluye 14 figuras en cuatro tamaños.",
        boton: "Elegir este set",
        nota: null,
    },
    {
        id: "set-standard-con-expresiones",
        nombre: "Set Standard con Expresiones",
        precio: 42990,
        precioTexto: "$42.990",
        imagen: "/images/products/set-standard-con-expresiones.webp",
        alt: "Set Standard con Expresiones de Famores",
        ancho: 1440,
        alto: 1168,
        descripcion:
            "Set de 14 figuras pintadas a mano con expresiones faciales que amplían las posibilidades de representación.",
        contenido: "Incluye 14 figuras en cuatro tamaños.",
        boton: "Elegir este set",
        nota: null,
    },
    {
        id: "set-sin-pintar",
        nombre: "Set Sin Pintar",
        precio: 25000,
        precioTexto: "$25.000",
        imagen: "/images/products/set-sin-pintar-1.jpg",
        alt: "Set Sin Pintar de Famores",
        ancho: 1440,
        alto: 1080,
        descripcion:
            "Set de 14 figuras en madera natural, preparado para pintar, intervenir o utilizar sin terminación de color.",
        contenido: "Incluye 14 figuras en cuatro tamaños.",
        boton: "Elegir este set",
        nota: null,
    },
    {
        id: "set-personalizado",
        nombre: "Set Personalizado",
        precio: 45000,
        precioTexto: "$45.000",
        imagen: "/images/products/set-personalizado-aymara.webp",
        alt: "Set Personalizado de Famores",
        ancho: 899,
        alto: 899,
        descripcion:
            "Set de 14 figuras elaborado a pedido, basado en una fotografía familiar, la representación de un pueblo originario o características específicas solicitadas por el cliente.",
        contenido: "Mantiene siempre las 14 figuras y sus cuatro tamaños.",
        boton: "Solicitar este set",
        nota: "Imagen referencial. El diseño se desarrolla según la solicitud del cliente.",
    },
];

const mascotas = [
    {
        id: "mascota-pintada",
        nombre: "Mascota Pintada",
        precio: 4500,
        precioTexto: "$4.500",
        imagen: "/images/products/mascota-pintada-2.jpg",
        alt: "Mascota Pintada de Famores",
        ancho: 1080,
        alto: 810,
        descripcion: "Mascota de madera pintada a mano. Valor por cada unidad.",
        pendiente: false,
    },
    {
        id: "mascota-sin-pintar",
        nombre: "Mascota Sin Pintar",
        precio: 2500,
        precioTexto: "$2.500",
        imagen: "/images/products/mascota-sin-pintar-1.jpg",
        alt: "Mascota Sin Pintar de Famores",
        ancho: 1080,
        alto: 1098,
        descripcion: "Mascota de madera natural, sin pintar. Valor por unidad.",
        pendiente: false,
    },
];
---

<section class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <div class="text-center max-w-2xl mx-auto mb-10">
        <span
            class="bg-terapia-sage text-white rounded-full w-6 h-6 inline-flex items-center justify-center text-sm mb-3"
            >1</span
        >
        <h2 class="text-2xl md:text-3xl font-bold text-terapia-text">
            Elige tus Famores
        </h2>
        <p class="text-gray-500 mt-3 pr-16 sm:pr-0">
            Puedes elegir un set completo, agregar una mascota o comprar solo una mascota. Antes de continuar podrás revisar y editar tu carrito.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {
            setsPrincipales.map((producto) => (
                <button
                    type="button"
                    class="option-card set-card smooth-transition rounded-2xl bg-white border border-stone-100 shadow-sm text-left flex flex-col overflow-hidden relative h-full"
                    id={`card-${producto.id}`}
                    onclick={`selectSet('${producto.nombre}', ${producto.precio})`}
                    aria-pressed="false"
                >
                    <div class="absolute top-3 right-3 selected-icon bg-white/95 text-terapia-sageDark rounded-full px-3 py-1 text-xs font-semibold flex items-center gap-1 shadow-sm z-10">
                        <i class="fa-solid fa-circle-check"></i> Set seleccionado
                    </div>

                    <div class="w-full aspect-[4/3] bg-terapia-bg overflow-hidden flex items-center justify-center">
                        <img
                            src={producto.imagen}
                            alt={producto.alt}
                            width={producto.ancho}
                            height={producto.alto}
                            loading="lazy"
                            class="max-w-full max-h-full object-contain"
                        />
                    </div>

                    <div class="p-5 flex flex-col flex-1">
                        <h3 class="font-semibold text-lg text-terapia-text leading-tight">
                            {producto.nombre}
                        </h3>
                        <p class="text-2xl font-bold text-terapia-sageDark mt-1 mb-2">
                            {producto.precioTexto}
                        </p>
                        <p class="text-sm text-gray-500">{producto.descripcion}</p>
                        <p class="text-xs font-medium text-terapia-wood mt-2">
                            {producto.contenido}
                        </p>

                        <div class="mt-3 min-h-[2.75rem]">
                            {producto.nota && (
                                <p class="text-xs italic text-terapia-wood bg-terapia-woodLight/15 rounded-lg px-3 py-2">
                                    {producto.nota}
                                </p>
                            )}
                        </div>

                        <span class="mt-auto inline-flex items-center justify-center gap-2 w-full rounded-xl bg-terapia-sage text-white font-semibold py-3 px-4 text-sm">
                            {producto.boton}
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </span>
                    </div>
                </button>
            ))
        }
    </div>

    <div class="text-center max-w-xl mx-auto mt-16 mb-8">
        <h3 class="text-xl md:text-2xl font-bold text-terapia-text">
            Elige una mascota
        </h3>
        <p class="text-gray-500 mt-2 text-sm">
            Puedes agregarla a un set o comprarla por separado. Si vuelves a tocar la misma mascota, se elimina de tu selección.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto items-stretch">
        {
            mascotas.map((producto) => (
                <button
                    type="button"
                    class="option-card mascota-card smooth-transition rounded-2xl bg-white border border-stone-100 shadow-sm text-left flex flex-col overflow-hidden relative"
                    id={`card-${producto.id}`}
                    onclick={`selectMascota('${producto.nombre}', ${producto.precio})`}
                    aria-pressed="false"
                >
                    <div class="absolute top-3 right-3 selected-icon bg-white/95 text-terapia-sageDark rounded-full px-3 py-1 text-xs font-semibold flex items-center gap-1 shadow-sm z-10">
                        <i class="fa-solid fa-circle-check"></i> Mascota agregada
                    </div>

                    {producto.imagen ? (
                        <div class="w-full aspect-[4/3] bg-terapia-bg overflow-hidden flex items-center justify-center">
                            <img
                                src={producto.imagen}
                                alt={producto.alt}
                                width={producto.ancho}
                                height={producto.alto}
                                loading="lazy"
                                class="max-w-full max-h-full object-contain"
                            />
                        </div>
                    ) : (
                        <div class="w-full aspect-[4/3] bg-terapia-bg overflow-hidden flex flex-col items-center justify-center gap-2 text-terapia-woodLight">
                            <i class="fa-solid fa-dog text-5xl"></i>
                            <span class="text-xs font-medium text-terapia-text/60">
                                Foto pendiente
                            </span>
                        </div>
                    )}

                    <div class="p-5 flex flex-col flex-1">
                        <h4 class="font-semibold text-lg text-terapia-text leading-tight">
                            {producto.nombre}
                        </h4>
                        <p class="text-xl font-bold text-terapia-sageDark mt-1 mb-2">
                            {producto.precioTexto}
                        </p>
                        <p class="text-sm text-gray-500">{producto.descripcion}</p>

                        <span class="mt-4 inline-flex items-center justify-center gap-2 w-full rounded-xl bg-terapia-woodLight/40 text-terapia-wood font-semibold py-2.5 px-4 text-sm">
                            Agregar al carrito
                        </span>
                    </div>
                </button>
            ))
        }
    </div>

    <aside id="carrito-famores" class="max-w-2xl mx-auto mt-12 rounded-2xl border border-terapia-sage/30 bg-white shadow-sm overflow-hidden" aria-live="polite">
        <div class="px-5 py-4 bg-terapia-sage/10 border-b border-terapia-sage/20 flex items-center justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-terapia-sageDark">Tu carrito</p>
                <h3 class="text-xl font-bold text-terapia-text">Revisa tu compra antes de continuar</h3>
            </div>
            <span id="carrito-contador" class="shrink-0 rounded-full bg-terapia-sage text-white text-sm font-bold min-w-8 h-8 px-2 inline-flex items-center justify-center">0</span>
        </div>

        <div class="p-5 space-y-3">
            <div id="carrito-vacio" class="rounded-xl border border-dashed border-gray-300 p-5 text-center text-sm text-gray-500">
                Tu carrito está vacío. Elige un set, una mascota o ambos.
            </div>

            <div id="carrito-set" class="hidden rounded-xl border border-gray-200 p-4 flex items-center justify-between gap-4">
                <div class="min-w-0">
                    <p class="text-xs text-gray-500">Set</p>
                    <p id="carrito-set-nombre" class="font-semibold text-terapia-text"></p>
                    <p id="carrito-set-precio" class="text-sm text-terapia-sageDark font-medium"></p>
                </div>
                <button type="button" onclick="quitarSetDelCarrito()" class="shrink-0 text-sm font-semibold text-red-700 hover:text-red-800 underline underline-offset-2">Quitar</button>
            </div>

            <div id="carrito-mascota" class="hidden rounded-xl border border-gray-200 p-4 flex items-center justify-between gap-4">
                <div class="min-w-0">
                    <p class="text-xs text-gray-500">Mascota</p>
                    <p id="carrito-mascota-nombre" class="font-semibold text-terapia-text"></p>
                    <p id="carrito-mascota-precio" class="text-sm text-terapia-sageDark font-medium"></p>
                </div>
                <button type="button" onclick="quitarMascotaDelCarrito()" class="shrink-0 text-sm font-semibold text-red-700 hover:text-red-800 underline underline-offset-2">Quitar</button>
            </div>

            <div class="pt-4 border-t border-gray-100 flex items-center justify-between gap-4">
                <span class="font-semibold text-terapia-text">Subtotal productos</span>
                <span id="carrito-total" class="text-2xl font-bold text-terapia-wood">$0</span>
            </div>
            <p class="text-xs text-gray-500">El envío se calcula o coordina en el siguiente paso. Puedes cambiar o quitar productos en cualquier momento antes de confirmar el pedido.</p>
        </div>
    </aside>
</section>

<style>
    button.set-card {
        display: flex;
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const formatoPrecio = (valor) => `$${Number(valor || 0).toLocaleString("es-CL")}`;

        function hayProductosReales() {
            return Boolean((state.set && state.set !== "Solo Mascota") || state.mascota);
        }

        function sincronizarPasoEnvio() {
            const hayProductos = hayProductosReales();
            const seccionEnvio = document.getElementById("section-envio");
            const avisoElegirSet = document.getElementById("aviso-elige-set");

            if (seccionEnvio) {
                seccionEnvio.classList.toggle("opacity-50", !hayProductos);
                seccionEnvio.classList.toggle("pointer-events-none", !hayProductos);
            }
            if (avisoElegirSet) {
                avisoElegirSet.textContent = "Elige al menos un producto para continuar";
                avisoElegirSet.classList.toggle("hidden", hayProductos);
            }
        }

        function sincronizarCarrito() {
            const setReal = state.set && state.set !== "Solo Mascota" ? state.set : null;
            const precioSet = setReal ? state.precioBase : 0;
            const mascota = state.mascota;
            const precioMascota = mascota ? state.precioMascota : 0;
            const cantidad = (setReal ? 1 : 0) + (mascota ? 1 : 0);

            const vacio = document.getElementById("carrito-vacio");
            const rowSet = document.getElementById("carrito-set");
            const rowMascota = document.getElementById("carrito-mascota");
            const contador = document.getElementById("carrito-contador");
            const total = document.getElementById("carrito-total");

            if (vacio) vacio.classList.toggle("hidden", cantidad > 0);
            if (contador) contador.textContent = String(cantidad);
            if (total) total.textContent = formatoPrecio(precioSet + precioMascota);

            if (rowSet) {
                rowSet.classList.toggle("hidden", !setReal);
                if (setReal) {
                    document.getElementById("carrito-set-nombre").textContent = setReal;
                    document.getElementById("carrito-set-precio").textContent = formatoPrecio(precioSet);
                }
            }

            if (rowMascota) {
                rowMascota.classList.toggle("hidden", !mascota);
                if (mascota) {
                    document.getElementById("carrito-mascota-nombre").textContent = mascota;
                    document.getElementById("carrito-mascota-precio").textContent = formatoPrecio(precioMascota);
                }
            }

            sincronizarPasoEnvio();
        }

        const selectSetOriginal = window.selectSet;
        if (typeof selectSetOriginal === "function") {
            window.selectSet = function(tipo, precio) {
                const mismoSet = state.set === tipo;
                if (mismoSet) {
                    state.set = null;
                    state.precioBase = 0;
                    document.querySelectorAll(".set-card").forEach((card) => {
                        card.classList.remove("selected");
                        card.setAttribute("aria-pressed", "false");
                    });
                    actualizarResumen();
                } else {
                    selectSetOriginal(tipo, precio);
                }
                sincronizarCarrito();
            };
        }

        const selectMascotaOriginal = window.selectMascota;
        if (typeof selectMascotaOriginal === "function") {
            window.selectMascota = function(tipo, precio) {
                selectMascotaOriginal(tipo, precio);
                sincronizarCarrito();
            };
        }

        window.quitarSetDelCarrito = function() {
            state.set = null;
            state.precioBase = 0;
            document.querySelectorAll(".set-card").forEach((card) => {
                card.classList.remove("selected");
                card.setAttribute("aria-pressed", "false");
            });
            actualizarResumen();
            sincronizarCarrito();
        };

        window.quitarMascotaDelCarrito = function() {
            state.mascota = null;
            state.precioMascota = 0;
            document.querySelectorAll(".mascota-card").forEach((card) => {
                card.classList.remove("selected");
                card.setAttribute("aria-pressed", "false");
            });
            actualizarResumen();
            sincronizarCarrito();
        };

        const actualizarResumenOriginal = window.actualizarResumen;
        if (typeof actualizarResumenOriginal === "function") {
            window.actualizarResumen = function() {
                actualizarResumenOriginal();

                if (!state.set && state.mascota && state.envio) {
                    const producto = document.getElementById("resumen-producto");
                    const precio = document.getElementById("resumen-precio");
                    const rowMascota = document.getElementById("resumen-mascota-row");
                    const nombreMascota = document.getElementById("resumen-mascota-nombre");
                    const precioMascota = document.getElementById("resumen-mascota-precio");
                    const total = document.getElementById("resumen-total");

                    if (producto) producto.textContent = "Compra sin set";
                    if (precio) precio.textContent = "$0";
                    if (rowMascota) rowMascota.classList.remove("hidden");
                    if (nombreMascota) nombreMascota.textContent = state.mascota;
                    if (precioMascota) precioMascota.textContent = formatoPrecio(state.precioMascota);
                    if (total) total.textContent = formatoPrecio(state.precioMascota + state.costoCaja);
                }
            };
        }

        const generarWhatsAppOriginal = window.generarWhatsApp;
        if (typeof generarWhatsAppOriginal === "function") {
            window.generarWhatsApp = function() {
                if (!state.set && state.mascota) {
                    state.set = "Solo Mascota";
                    state.precioBase = 0;
                }
                return generarWhatsAppOriginal();
            };
        }

        sincronizarCarrito();
    });
</script>