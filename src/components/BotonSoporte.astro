---
const numeroFamores = "56962052499";
const mensaje = "¡Hola Famores! 👋 vengo desde la página web. Tengo una duda sobre...";
const urlWhatsApp = `https://wa.me/${numeroFamores}?text=${encodeURIComponent(mensaje)}`;
---

<a
    href={urlWhatsApp}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Hablar con Famores por WhatsApp"
    class="boton-soporte-whatsapp fixed bg-[#25D366] hover:bg-[#1DA851] text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-300 flex items-center justify-center gap-2 z-50"
>
    <i class="fa-brands fa-whatsapp text-2xl" aria-hidden="true"></i>
    <span class="boton-soporte-whatsapp__texto font-semibold">Hablar con Famores</span>
</a>

<style>
    /* Compacto y circular en móvil/tablet para no tapar botones, tarjetas
       ni texto al hacer scroll (el aria-label conserva el nombre accesible
       aunque el texto quede oculto). Vuelve a pastilla con texto solo desde
       escritorio (>=1024px), donde hay margen suficiente. */
    .boton-soporte-whatsapp {
        right: max(1rem, env(safe-area-inset-right));
        bottom: max(1rem, env(safe-area-inset-bottom));
        width: 3.25rem;
        height: 3.25rem;
        padding: 0;
    }

    .boton-soporte-whatsapp:hover,
    .boton-soporte-whatsapp:focus-visible {
        transform: translateY(-4px);
    }

    .boton-soporte-whatsapp:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 2px;
    }

    .boton-soporte-whatsapp__texto {
        display: none;
    }

    @media (min-width: 1024px) {
        .boton-soporte-whatsapp {
            right: calc(1.5rem + env(safe-area-inset-right));
            bottom: calc(1.5rem + env(safe-area-inset-bottom));
            width: auto;
            height: auto;
            padding: 0.75rem 1.25rem;
        }

        .boton-soporte-whatsapp__texto {
            display: inline;
        }
    }
</style>
