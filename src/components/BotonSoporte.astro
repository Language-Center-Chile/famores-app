---
const numeroFamores = "56962052499";
const mensaje = "¡Hola Famores! 👋 vengo desde la página web. Tengo una duda sobre...";
const urlWhatsApp = `https://wa.me/${numeroFamores}?text=${encodeURIComponent(mensaje)}`;
---

<a href={urlWhatsApp} target="_blank" rel="noopener noreferrer" class="fixed bottom-6 right-6 bg-[#25D366] hover:bg-[#1DA851] text-white py-3 px-5 rounded-full shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-2 z-50">
    <i class="fa-brands fa-whatsapp text-2xl"></i>
    <span class="font-semibold hidden sm:inline">Hablar con Famores</span>
</a>
