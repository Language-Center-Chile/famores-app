---
interface Props { name:'cart'|'cart-plus'|'whatsapp'|'instagram'|'threads'; }
const {name}=Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="inline-block w-[1em] h-[1em] shrink-0 align-middle" aria-hidden="true" focusable="false">
  {(name==='cart'||name==='cart-plus')&&<><path d="M2 3h3l3 13h11l2-9H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/>{name==='cart-plus'&&<path d="M13 5v6m-3-3h6"/>}</>}
  {name==='whatsapp'&&<><path d="M21 11.5a9 9 0 0 1-13.5 8L3 21l1.5-4.5A9 9 0 1 1 21 11.5Z"/><path d="m8 7-1 2c1 4 3 6 7 7l2-1-2-3-2 1-2-2 1-2-3-2Z"/></>}
  {name==='instagram'&&<><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/></>}
  {name==='threads'&&<><circle cx="12" cy="12" r="9"/><text x="12" y="16" text-anchor="middle" stroke="none" fill="currentColor" font-size="14">@</text></>}
</svg>
