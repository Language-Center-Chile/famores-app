    document.addEventListener("DOMContentLoaded", () => {
        const selectRegion = document.getElementById("select-region");
        if (selectRegion) {
            Object.keys(dataRegiones).forEach(region => {
                const option = document.createElement("option");
                option.value = region;
                option.text = region;
                selectRegion.appendChild(option);
            });
        }
    });

    function actualizarComunas() {
        const selectRegion = document.getElementById("select-region");
        const selectComuna = document.getElementById("input-comuna");
        const regionSeleccionada = selectRegion.value;
        
        selectComuna.innerHTML = '<option value="">Selecciona tu comuna</option>';
        
        if (regionSeleccionada && dataRegiones[regionSeleccionada]) {
            dataRegiones[regionSeleccionada].forEach(comuna => {
                const option = document.createElement("option");
                option.value = comuna;
                option.text = comuna;
                selectComuna.appendChild(option);
            });
            selectComuna.disabled = false;
        } else {
            selectComuna.disabled = true;
        }
    }

    // --- Lógica Dinámica de Checkout (Método de Envío) ---
    document.addEventListener('DOMContentLoaded', () => {
        // En tu proyecto usas divs interactivos (cards) que llaman a selectShipping()
        // en lugar de un <select>. Así que adaptamos tu script para que intercepte esa función:
        const opcionesCourier = document.getElementById('opciones-courier');
        const opcionesRetiro = document.getElementById('opciones-retiro');
        const bloqueDireccion = document.getElementById('bloque-direccion');
        const inputDireccion = document.getElementById('input-direccion');
        const selectRegion = document.getElementById('select-region');
        const selectComuna = document.getElementById('input-comuna');

        const radiosCourier = opcionesCourier ? opcionesCourier.querySelectorAll('input[type="radio"]') : [];
        const radiosRetiro = opcionesRetiro ? opcionesRetiro.querySelectorAll('input[type="radio"]') : [];
        const radioDomicilio = opcionesCourier ? opcionesCourier.querySelector('input[value="domicilio"]') : null;
        const radioSucursal = opcionesCourier ? opcionesCourier.querySelector('input[value="sucursal"]') : null;

        function limpiarYQuitarRequerido(radios) {
            radios.forEach(radio => {
                radio.checked = false;
                radio.removeAttribute('required');
            });
        }

        function exigir(radios) {
            radios.forEach(radio => radio.setAttribute('required', 'true'));
        }

        // Dentro de courier: si elige "sucursal" no se exige dirección;
        // si elige "domicilio" sí se exige.
        function actualizarDireccionSegunModalidad() {
            if (!bloqueDireccion || !inputDireccion) return;
            if (radioSucursal && radioSucursal.checked) {
                bloqueDireccion.classList.add('hidden');
                inputDireccion.removeAttribute('required');
                inputDireccion.value = '';
            } else {
                bloqueDireccion.classList.remove('hidden');
                inputDireccion.setAttribute('required', 'true');
            }
        }

        if (radioDomicilio) radioDomicilio.addEventListener('change', actualizarDireccionSegunModalidad);
        if (radioSucursal) radioSucursal.addEventListener('change', actualizarDireccionSegunModalidad);

        if (typeof window.selectShipping === 'function') {
            const selectShippingOriginal = window.selectShipping;

            window.selectShipping = function(metodo) {
                // Primero, ejecutamos el código original de tus cards
                selectShippingOriginal(metodo);

                const esRetiro = metodo.toLowerCase().includes('retiro');

                if (esRetiro) {
                    if (opcionesCourier) opcionesCourier.classList.add('hidden');
                    if (opcionesRetiro) opcionesRetiro.classList.remove('hidden');
                    if (bloqueDireccion) bloqueDireccion.classList.add('hidden');

                    // Limpiar selección y datos de courier que ya no aplican
                    limpiarYQuitarRequerido(radiosCourier);
                    exigir(radiosRetiro);
                    if (inputDireccion) {
                        inputDireccion.removeAttribute('required');
                        inputDireccion.value = '';
                    }
                    if (selectRegion) selectRegion.value = '';
                    if (selectComuna) {
                        selectComuna.innerHTML = '<option value="">Selecciona tu comuna</option>';
                        selectComuna.disabled = true;
                    }
                } else {
                    if (opcionesCourier) opcionesCourier.classList.remove('hidden');
                    if (opcionesRetiro) opcionesRetiro.classList.add('hidden');

                    // Limpiar selección de retiro que ya no aplica
                    limpiarYQuitarRequerido(radiosRetiro);
                    exigir(radiosCourier);
                    actualizarDireccionSegunModalidad();
                }
            };
        }
    });
</script>
