<div
    class="relative w-full min-h-[70vh] flex flex-col items-center justify-center text-center overflow-hidden"
>
    <video
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 object-cover w-full h-full -z-10"
    >
        <source src="/videos/hero-famores.mp4" type="video/mp4" />
    </video>

    <div class="absolute inset-0 bg-black/60 z-0"></div>

    <!-- Marca de agua del logo recortada (isotipo) con tamaño responsivo estricto -->
    <img
        src="/images/brand/logo-famores.png"
        alt="Logo de Famores"
        class="absolute inset-0 m-auto w-[50%] md:w-[25%] object-contain opacity-20 mix-blend-multiply [clip-path:inset(35%_0_0_0)] -translate-y-[17.5%] pointer-events-none z-10" 
    />

    <div
        class="relative z-20 space-y-2 p-6 flex flex-col items-center justify-center"
    >
        <h1
            class="text-4xl font-extrabold text-white tracking-tight drop-shadow-md"
        >
            FAMORES
        </h1>
        <p class="text-xl md:text-2xl font-light italic text-gray-200 mt-2 drop-shadow">
            ¡Que sanes muchas Familias!
        </p>
    </div>
</div>
