---
import BotonSoporte from '../components/BotonSoporte.astro';
import '../styles/site.css';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
}

const { title = "Famores" } = Astro.props;
const description = "Diseña tu set de herramientas terapéuticas sistémicas de forma personalizada.";
const siteBase = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteBase);
const ogImageUrl = new URL("/images/content/promo-set-standard.jpg", siteBase);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="referrer" content="same-origin" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/images/brand/logo-famores.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:title" content="Famores - Herramientas Sistémicas" />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content="Set de figuras terapéuticas sistémicas Famores" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_CL" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Famores - Herramientas Sistémicas" />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Set de figuras terapéuticas sistémicas Famores" />


	</head>
	<body class="min-h-screen py-10 px-4 sm:px-6 lg:px-8">
		<a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
		<slot />
		<BotonSoporte />
		<Footer />
		<script src="/js/delivery-cards.js" defer></script>
	</body>
</html>

<style is:global>
	body {
		background-color: #fdfbf7;
		color: #4a4a4a;
	}

	.skip-link {
		position: fixed;
		top: 1rem;
		left: 1rem;
		z-index: 100;
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
		background-color: #5e7a68;
		color: #fff;
		font-weight: 600;
		transform: translateY(-200%);
		transition: transform 0.2s ease-in-out;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}

		.hero-background-video {
			display: none;
		}
	}
</style>
