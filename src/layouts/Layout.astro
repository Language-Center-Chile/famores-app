---
import BotonSoporte from '../components/BotonSoporte.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
}

const { title = "Cotizador FAMORES" } = Astro.props;
const description = "Diseña tu set de herramientas terapéuticas sistémicas de forma personalizada.";
// Astro.url.origin no es confiable detrás de un proxy reverso (Coolify):
// @astrojs/node deriva el protocolo del socket TCP crudo (req.socket.encrypted),
// no de X-Forwarded-Proto, así que detrás de un proxy que termina TLS siempre
// resolvería "http://" aunque el sitio público sea HTTPS. Astro.site (configurado
// en astro.config.mjs) es la fuente correcta para canonical/og:image.
const siteBase = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteBase);
const ogImageUrl = new URL("/images/content/promo-set-standard.jpg", siteBase);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<script is:inline>
			// Captura de atribución: guarda los utm_* de la URL de llegada en
			// sessionStorage. Solo se sobrescribe cuando la URL trae utm_source
			// nuevo, así una navegación interna sin params no borra el origen
			// original del lead dentro de la misma sesión.
			(function captureUtm() {
				const MAX_LENGTH = 200;
				const params = new URLSearchParams(window.location.search);
				if (!params.has("utm_source")) return;
				const clip = (value) => (value || "").slice(0, MAX_LENGTH);
				const utm = {
					utm_source: clip(params.get("utm_source")),
					utm_medium: clip(params.get("utm_medium")),
					utm_campaign: clip(params.get("utm_campaign")),
					utm_content: clip(params.get("utm_content")),
					utm_term: clip(params.get("utm_term")),
				};
				try {
					sessionStorage.setItem("famores_utm", JSON.stringify(utm));
				} catch (error) {
					console.warn("No se pudo guardar la atribución UTM:", error);
				}
			})();
		</script>

		<meta property="og:title" content="Famores - Herramientas Sistémicas" />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:type" content="website" />

		<script is:inline src="https://cdn.tailwindcss.com"></script>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			tailwind.config = {
				theme: {
					extend: {
						fontFamily: {
							sans: ['Inter', 'sans-serif'],
						},
						colors: {
							terapia: {
								bg: '#FDFBF7', /* Beige muy suave y cálido */
								wood: '#8B5A2B', /* Tono madera para Famores */
								woodLight: '#D2B48C', /* Madera clara */
								sage: '#8FAC9A', /* Verde salvia que da tranquilidad */
								sageDark: '#5E7A68',
								text: '#4A4A4A' /* Gris oscuro, menos agresivo que el negro puro */
							}
						}
					}
				}
			}
		</script>
	</head>
	<body class="min-h-screen py-10 px-4 sm:px-6 lg:px-8">
		<slot />
		<script is:inline src="/js/checkout-v2.js"></script>
		<BotonSoporte />
		<Footer />
	</body>
</html>

<style is:global>
	body {
		background-color: #fdfbf7;
		color: #4a4a4a;
	}

	/* Animación suave para todas las interacciones */
	.smooth-transition {
		transition: all 0.3s ease-in-out;
	}

	/* Estilo para las tarjetas seleccionables */
	.option-card {
		border: 2px solid #e5e7eb;
		cursor: pointer;
	}

	/* Reset mínimo para tarjetas que son <button> reales (accesibilidad) */
	button.option-card {
		display: block;
		width: 100%;
		text-align: left;
		background: none;
		font: inherit;
		color: inherit;
	}

	.option-card:hover {
		border-color: #d2b48c;
		transform: translateY(-2px);
		box-shadow:
			0 4px 6px -1px rgba(0, 0, 0, 0.1),
			0 2px 4px -1px rgba(0, 0, 0, 0.06);
	}

	.option-card:focus-visible {
		outline: 2px solid #8fac9a;
		outline-offset: 2px;
	}

	/* Clase que se aplica cuando el cliente selecciona una opción */
	.option-card.selected {
		border-color: #8fac9a;
		background-color: #f4f8f5; /* Fondo salvia muy claro */
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
	}

	.selected-icon {
		opacity: 0;
		transform: scale(0.5);
		transition: all 0.3s ease;
	}

	.option-card.selected .selected-icon {
		opacity: 1;
		transform: scale(1);
		color: #8fac9a;
	}
</style>
