---
import BotonSoporte from '../components/BotonSoporte.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
}

const { title = "Famores" } = Astro.props;
const description = "Diseña tu set de herramientas terapéuticas sistémicas de forma personalizada.";
const siteBase = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteBase);
const ogImageUrl = new URL("/images/content/promo-set-standard.jpg", siteBase);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/images/brand/logo-famores.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<script is:inline>
			(function captureUtm() {
				const params = new URLSearchParams(window.location.search);
				if (!params.has("utm_source")) return;
				const utm = {
					utm_source: params.get("utm_source") || "",
					utm_medium: params.get("utm_medium") || "",
					utm_campaign: params.get("utm_campaign") || "",
					utm_content: params.get("utm_content") || "",
					utm_term: params.get("utm_term") || "",
				};
				try {
					sessionStorage.setItem("famores_utm", JSON.stringify(utm));
				} catch (error) {
					console.warn("No se pudo guardar la atribución UTM:", error);
				}
			})();
		</script>

		<meta property="og:title" content="Famores - Herramientas Sistémicas" />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content="Set de figuras terapéuticas sistémicas Famores" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_CL" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Famores - Herramientas Sistémicas" />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Set de figuras terapéuticas sistémicas Famores" />

		<script is:inline src="https://cdn.tailwindcss.com"></script>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			tailwind.config = {
				theme: {
					extend: {
						fontFamily: { sans: ['Inter', 'sans-serif'] },
						colors: {
							terapia: {
								bg: '#FDFBF7',
								wood: '#8B5A2B',
								woodLight: '#D2B48C',
								sage: '#8FAC9A',
								sageDark: '#5E7A68',
								text: '#4A4A4A'
							}
						}
					}
				}
			}
		</script>
	</head>
	<body class="min-h-screen py-10 px-4 sm:px-6 lg:px-8">
		<a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
		<slot />
		<BotonSoporte />
		<Footer />
	</body>
</html>

<style is:global>
	body {
		background-color: #fdfbf7;
		color: #4a4a4a;
	}

	.skip-link {
		position: fixed;
		top: 1rem;
		left: 1rem;
		z-index: 100;
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
		background-color: #5e7a68;
		color: #fff;
		font-weight: 600;
		transform: translateY(-200%);
		transition: transform 0.2s ease-in-out;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}

		.hero-background-video {
			display: none;
		}
	}
</style>
