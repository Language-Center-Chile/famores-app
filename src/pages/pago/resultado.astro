---
import Layout from "../../layouts/Layout.astro";
import { getFlowPaymentStatus } from "../../lib/flow";

const token = Astro.url.searchParams.get("token") || "";
let payment: any = null;
let error = Astro.url.searchParams.get("error") || "";

if (token) {
  try {
    payment = await getFlowPaymentStatus(token);
  } catch (err) {
    error = err instanceof Error ? err.message : "No fue posible verificar el pago.";
  }
}

const statusInfo: Record<number, { title: string; message: string; icon: string }> = {
  1: {
    title: "Pago pendiente",
    message: "Flow todavía no confirma el pago. Puedes volver a revisar en unos minutos.",
    icon: "⏳",
  },
  2: {
    title: "Pago confirmado",
    message: "Tu pago fue confirmado por Flow. Ahora confirma el pedido por WhatsApp para que Famores reciba el resumen y los datos de entrega.",
    icon: "✅",
  },
  3: {
    title: "Pago rechazado",
    message: "El pago fue rechazado. Puedes volver al pedido e intentar nuevamente.",
    icon: "❌",
  },
  4: {
    title: "Pago anulado",
    message: "La orden de pago fue anulada. Puedes volver al pedido y generar una nueva orden.",
    icon: "⚠️",
  },
};

const info = payment ? statusInfo[Number(payment.status)] : null;

let orderData: any = {};
if (payment?.optional) {
  try {
    orderData = typeof payment.optional === "string" ? JSON.parse(payment.optional) : payment.optional;
  } catch {
    orderData = {};
  }
}

const customer = orderData?.customer || {};
const items = Array.isArray(orderData?.items) ? orderData.items : [];
const itemLines = items.length
  ? items.map((item: any) => `- ${Number(item.quantity || 0)} x ${String(item.product || "Producto")}`).join("\n")
  : "- Pedido asociado a la orden de Flow";

const locationLines = [
  orderData?.region ? `- Región: ${orderData.region}` : "",
  orderData?.commune ? `- Comuna: ${orderData.commune}` : "",
  orderData?.country ? `- País: ${orderData.country}` : "",
  orderData?.city ? `- Ciudad: ${orderData.city}` : "",
  orderData?.deliveryAddress ? `- Dirección: ${orderData.deliveryAddress}` : "",
  orderData?.branchName ? `- Sucursal: ${orderData.branchName}` : "",
  orderData?.pickupAddress ? `- Retiro: ${orderData.pickupAddress}` : "",
].filter(Boolean).join("\n");

const shippingLine = orderData?.internationalShippingQuotePending
  ? "- Despacho: pendiente de cotización internacional"
  : orderData?.shipping !== undefined
    ? `- Despacho: $${Number(orderData.shipping || 0).toLocaleString("es-CL")}`
    : "";

const whatsappMessage = payment && Number(payment.status) === 2
  ? `¡Hola Famores! Mi pago fue confirmado por Flow y quiero confirmar mi pedido.\n\n*Pedido*\n${itemLines}\n\n*Pago*\n- Orden Famores: ${payment.commerceOrder || ""}\n- Orden Flow: ${payment.flowOrder || ""}\n- Total pagado ahora: $${Number(payment.amount || 0).toLocaleString("es-CL")}\n${shippingLine}\n\n*Entrega*\n- Modalidad: ${orderData?.deliveryMethod || orderData?.courier || "No especificada"}${locationLines ? `\n${locationLines}` : ""}\n\n*Mis datos*\n- Nombre: ${customer?.fullName || `${customer?.firstName || ""} ${customer?.lastName || ""}`.trim() || "No informado"}\n- RUT/DNI: ${customer?.customerId || "No informado"}\n- Correo: ${customer?.email || payment?.payer || "No informado"}\n\nGracias. Quedo atento/a a la confirmación de Famores.${orderData?.internationalShippingQuotePending ? "\n\n*Nota:* El despacho internacional queda pendiente de cotización posterior." : ""}`
  : "";

const whatsappUrl = whatsappMessage
  ? `https://wa.me/56962052499?text=${encodeURIComponent(whatsappMessage)}`
  : "";
---

<Layout title="Resultado de pago | FAMORES">
  <main id="contenido-principal" class="max-w-xl mx-auto bg-white rounded-2xl shadow-sm border border-stone-100 p-6 md:p-8">
    {error ? (
      <>
        <div class="text-4xl text-center mb-3">⚠️</div>
        <h1 class="text-2xl font-bold text-terapia-text text-center">No pudimos verificar el pago</h1>
        <p class="text-gray-600 text-center mt-3">{error}</p>
      </>
    ) : info ? (
      <>
        <div class="text-4xl text-center mb-3">{info.icon}</div>
        <h1 class="text-2xl font-bold text-terapia-text text-center">{info.title}</h1>
        <p class="text-gray-600 text-center mt-3">{info.message}</p>
        <div class="mt-6 rounded-xl bg-terapia-bg p-4 text-sm space-y-2">
          <div class="flex justify-between gap-4"><span>Orden Famores</span><strong>{payment.commerceOrder}</strong></div>
          <div class="flex justify-between gap-4"><span>Orden Flow</span><strong>{payment.flowOrder}</strong></div>
          <div class="flex justify-between gap-4"><span>Monto</span><strong>${Number(payment.amount || 0).toLocaleString("es-CL")}</strong></div>
        </div>
        {whatsappUrl && (
          <div class="mt-6 rounded-xl border border-green-200 bg-green-50 p-4">
            <p class="text-sm text-green-900"><strong>Último paso:</strong> abre WhatsApp y envía el mensaje preparado. Así Famores recibe inmediatamente tu pedido, correo y datos de entrega.</p>
            <a id="whatsapp-confirm" href={whatsappUrl} class="mt-4 w-full inline-flex items-center justify-center rounded-xl bg-green-700 text-white font-semibold py-3 px-4 hover:bg-green-800 smooth-transition">
              Confirmar pedido por WhatsApp
            </a>
            <p class="mt-2 text-xs text-green-800">El mensaje queda preparado automáticamente; tú solo debes presionar Enviar en WhatsApp.</p>
          </div>
        )}
      </>
    ) : (
      <>
        <div class="text-4xl text-center mb-3">ℹ️</div>
        <h1 class="text-2xl font-bold text-terapia-text text-center">Sin información de pago</h1>
        <p class="text-gray-600 text-center mt-3">No recibimos un token de transacción para verificar.</p>
      </>
    )}

    <a href="/" class="mt-7 w-full inline-flex items-center justify-center rounded-xl bg-terapia-sage text-white font-semibold py-3 px-4 hover:bg-terapia-sageDark smooth-transition">
      Volver a Famores
    </a>
  </main>

  {whatsappUrl && (
    <script is:inline define:vars={{ whatsappUrl }}>
      window.setTimeout(() => {
        window.location.href = whatsappUrl;
      }, 1800);
    </script>
  )}
</Layout>
