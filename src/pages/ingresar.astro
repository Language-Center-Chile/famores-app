---
import Layout from '../layouts/Layout.astro';
import { commerceEnabled } from '../lib/commerce';
import { privateHeaders } from '../lib/account';
Object.entries(privateHeaders).forEach(([key,value])=>Astro.response.headers.set(key,value));
---
<Layout title="Mi cuenta | Famores">
  <main class="max-w-lg mx-auto px-6 py-12">
    <a href="/">← Volver a Famores</a>
    <h1 class="text-3xl font-bold my-6">Tu espacio Famores</h1>
    <p>Compra con tu cuenta, consulta tus pedidos o accede a tu panel de vendedor.</p>
    {!commerceEnabled() ? <p class="my-6" role="status">El acceso estará disponible próximamente. Puedes comprar como invitado.</p> : <form method="post" action="/api/account/login" class="grid gap-4 my-6">
      {Astro.url.searchParams.has('verified') && <p role="status">Correo verificado. Ya puedes ingresar.</p>}
      {Astro.url.searchParams.has('reset') && <p role="status">Contraseña actualizada.</p>}
      {Astro.url.searchParams.has('error') && <p role="alert">Correo o contraseña incorrectos.</p>}
      <label for="email">Correo</label><input id="email" name="email" type="email" autocomplete="username" required maxlength="160" class="border rounded-xl p-3" />
      <label for="password">Contraseña</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="256" class="border rounded-xl p-3" />
      <button class="rounded-xl bg-terapia-sage text-white p-3 font-bold">Ingresar</button>
      <p class="text-sm">Compradores: <a href="/recuperar" class="underline">recuperar contraseña</a>. Vendedores y administración: contacta a Famores.</p>
    </form>}
    <p><a href="/registrarse" class="underline">Crear cuenta de comprador</a> · <a href="/comprar" class="underline">Comprar sin registro</a></p><a href="/alianzas" class="underline">Quiero revender Famores</a>
  </main>
</Layout>
