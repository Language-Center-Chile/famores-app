---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Set from "../components/Set.astro";
import ComposicionSet from "../components/ComposicionSet.astro";
import Modalidad from "../components/Modalidad.astro";
import Datos from "../components/Datos.astro";
import MapaLocal from "../components/MapaLocal.astro";
---

<Layout title="Cotizador FAMORES">
    <main id="contenido-principal">
        <Hero />

        <Set />

        <ComposicionSet />

        <div class="max-w-3xl mx-auto space-y-8 px-4 pb-12 mt-4">
            <Modalidad />
            <MapaLocal />
            <Datos />
        </div>
    </main>

    <script is:inline>
        // Variables de estado
        // "set" (obligatorio) y "mascota" (complemento opcional) son
        // independientes: elegir una mascota no reemplaza ni desmarca el
        // set principal, y cambiar de set no afecta a la mascota elegida.
        let state = {
            set: null,
            precioBase: 0,
            mascota: null,
            precioMascota: 0,
            envio: null,
            costoCaja: 0,
        };

        // Única dirección oficial de retiro presencial que debe aparecer
        // en cualquier texto público del sitio.
        const DIRECCION_RETIRO = "Avenida Egaña 1638-B, Peñalolén, Santiago, Chile";

        // Enlaces estáticos de Flow: cada botón cobra un monto fijo, por eso
        // solo existen para sets principales cuyo precio representa el total
        // exacto del pedido (sin mascota agregada). No agregar aquí entradas
        // de mascota: ningún enlace Flow cobra el combinado set + mascota.
        const flowLinks = {
            "Set Standard Pintado":
                "https://www.flow.cl/btn.php?token=1uikdzp",
            "Set Sin Pintar": "https://www.flow.cl/btn.php?token=hqqv39f",
            "Set Personalizado": "https://www.flow.cl/btn.php?token=kvyqkd4",
        };

        // Única regla que decide si un enlace Flow puede abrirse
        // directamente: debe cobrar exactamente el total mostrado (sin
        // mascota, sin Chilexpress pendiente de cotizar, y con enlace
        // configurado para el set elegido).
        function puedePagarDirectamenteConFlow(metodoPago) {
            return (
                metodoPago === "Link de Pago (Flow)" &&
                state.envio !== "chilexpress" &&
                state.envio !== "internacional" &&
                !state.mascota &&
                Boolean(flowLinks[state.set])
            );
        }

        // Canal de pago real según el método elegido y el estado actual.
        // Prioridad: Internacional > Chilexpress > Flow inválido (sin
        // enlace o con mascota) > Flow válido > Transferencia. Se usa
        // tanto para decidir qué bloque de pago mostrar como para
        // registrar el método real en Google Sheets, así ambos quedan
        // siempre sincronizados. Un pedido internacional nunca abre Flow,
        // sin importar el método de pago elegido en el <select>.
        function obtenerCanalPago(metodoPago) {
            if (state.envio === "internacional") return "internacional";
            if (state.envio === "chilexpress") return "chilexpress";
            if (metodoPago === "Link de Pago (Flow)") {
                if (puedePagarDirectamenteConFlow(metodoPago))
                    return "flow-directo";
                if (!flowLinks[state.set]) return "flow-sin-enlace";
                return "flow-pedido-combinado";
            }
            return "transferencia";
        }

        // Función cuando seleccionan un Set principal (grupo exclusivo: .set-card)
        function selectSet(tipo, precio) {
            state.set = tipo;
            state.precioBase = precio;

            // Cambiar estilos visuales dinámicamente solo entre las 4 tarjetas
            // de set (no toca las tarjetas de mascota ni las de envío)
            const allSetCards = document.querySelectorAll(".set-card");
            allSetCards.forEach((card) => {
                card.classList.remove("selected");
                if (card.hasAttribute("aria-pressed")) {
                    card.setAttribute("aria-pressed", "false");
                }
            });

            // Generar ID de la card a partir del nombre
            const cardId = "card-" + tipo.toLowerCase().replace(/ /g, "-");
            const selectedCard = document.getElementById(cardId);
            if (selectedCard) {
                selectedCard.classList.add("selected");
                if (selectedCard.hasAttribute("aria-pressed")) {
                    selectedCard.setAttribute("aria-pressed", "true");
                }
            }

            // Habilitar la sección de envío
            let seccionEnvio = document.getElementById("section-envio");
            if (seccionEnvio)
                seccionEnvio.classList.remove(
                    "opacity-50",
                    "pointer-events-none",
                );

            // Ocultar el aviso de "elige un set primero" una vez habilitada
            let avisoElegirSet = document.getElementById("aviso-elige-set");
            if (avisoElegirSet) avisoElegirSet.classList.add("hidden");

            actualizarResumen();
        }

        // Función cuando seleccionan una Mascota (grupo exclusivo: .mascota-card,
        // independiente del set). Volver a hacer click sobre la mascota ya
        // seleccionada la quita (no obliga a tener una mascota).
        function selectMascota(tipo, precio) {
            const cardId = "card-" + tipo.toLowerCase().replace(/ /g, "-");
            const yaSeleccionada = state.mascota === tipo;

            document.querySelectorAll(".mascota-card").forEach((card) => {
                card.classList.remove("selected");
                if (card.hasAttribute("aria-pressed")) {
                    card.setAttribute("aria-pressed", "false");
                }
            });

            if (yaSeleccionada) {
                // Quitar la mascota
                state.mascota = null;
                state.precioMascota = 0;
            } else {
                state.mascota = tipo;
                state.precioMascota = precio;

                const selectedCard = document.getElementById(cardId);
                if (selectedCard) {
                    selectedCard.classList.add("selected");
                    if (selectedCard.hasAttribute("aria-pressed")) {
                        selectedCard.setAttribute("aria-pressed", "true");
                    }
                }
            }

            actualizarResumen();
        }

        // Función cuando seleccionan Método de Envío
        function selectShipping(metodo) {
            state.envio = metodo;

            // Si es chilexpress, sumamos la caja
            state.costoCaja = metodo === "chilexpress" ? 1500 : 0;

            // Cambiar estilos visuales (solo tarjetas de despacho, la selección
            // de producto no debe verse afectada)
            const allShippingCards = document.querySelectorAll(".shipping-card");
            allShippingCards.forEach((card) => card.classList.remove("selected"));

            document.getElementById(`card-${metodo}`).classList.add("selected");

            // Mostrar u ocultar Región/Comuna: no aplica para retiro (no se
            // despacha) ni para internacional (usa País/Ciudad, gestionado
            // aparte en Datos.astro).
            const containerRC = document.getElementById(
                "container-region-comuna",
            );
            if (containerRC) {
                if (metodo === "retiro" || metodo === "internacional") {
                    containerRC.classList.add("hidden");
                } else {
                    containerRC.classList.remove("hidden");
                }
            }

            // Mostrar u ocultar el Mapa Local dependiendo de si es retiro
            const containerMapa = document.getElementById("contenedor-mapa");
            if (containerMapa) {
                if (metodo === "retiro") {
                    containerMapa.classList.remove("hidden");
                } else {
                    containerMapa.classList.add("hidden");
                }
            }

            // Mostrar el formulario final
            document.getElementById("section-datos").classList.remove("hidden");

            actualizarResumen();
        }

        // Actualizar los textos y matemáticas del resumen
        function actualizarResumen() {
            if (!state.set || !state.envio) return;

            document.getElementById("resumen-producto").innerText = state.set;
            document.getElementById("resumen-precio").innerText =
                `$${state.precioBase.toLocaleString("es-CL")}`;

            // Mascota opcional: fila independiente del set, no reemplaza su nombre
            const rowMascota = document.getElementById("resumen-mascota-row");
            if (rowMascota) {
                if (state.mascota) {
                    document.getElementById("resumen-mascota-nombre").innerText =
                        state.mascota;
                    document.getElementById("resumen-mascota-precio").innerText =
                        `$${state.precioMascota.toLocaleString("es-CL")}`;
                    rowMascota.classList.remove("hidden");
                } else {
                    rowMascota.classList.add("hidden");
                }
            }

            const rowCaja = document.getElementById("resumen-caja-row");
            const notaEnvio = document.getElementById("resumen-nota-envio");

            if (state.envio === "chilexpress") {
                rowCaja.classList.remove("hidden");
                notaEnvio.innerText =
                    "* Nota: Famores cotizará el despacho por Chilexpress y te confirmará el total antes de solicitar el pago.";
            } else if (state.envio === "starken") {
                rowCaja.classList.add("hidden");
                notaEnvio.innerText =
                    "* Nota: Pagarás el envío directamente a Starken cuando recibas tu paquete.";
            } else if (state.envio === "internacional") {
                rowCaja.classList.add("hidden");
                notaEnvio.innerText =
                    "Despacho internacional pendiente de cotización. El total mostrado no incluye envío, courier, impuestos, aduanas ni otros cargos asociados.";
            } else {
                rowCaja.classList.add("hidden");
                notaEnvio.innerText =
                    "* Nota: Famores se pondrá en contacto contigo para coordinar el retiro en Avenida Egaña 1638-B, Peñalolén.";
            }

            const total = state.precioBase + state.precioMascota + state.costoCaja;
            document.getElementById("resumen-total").innerText =
                `$${total.toLocaleString("es-CL")}`;

            // Aviso temporal: productos sin link de Flow confirmado todavía
            // (por ahora, Set Standard con Expresiones). No afecta el cálculo del total.
            const notaPago = document.getElementById("resumen-nota-pago");
            if (notaPago) {
                if (state.set === "Set Standard con Expresiones") {
                    notaPago.innerText =
                        "* Este set aún no tiene link de pago Flow: coordinaremos tu pago directamente por WhatsApp.";
                    notaPago.classList.remove("hidden");
                } else {
                    notaPago.classList.add("hidden");
                }
            }
        }

        // Función que genera el mensaje, envía datos a Python y abre WhatsApp
        function generarWhatsApp() {
            const btn =
                document.getElementById("btn-submit-main") ||
                document.querySelector('button[onclick="generarWhatsApp()"]');
            const originalText = btn.innerHTML;
            const errorEl = document.getElementById("form-error-message");

            const mostrarError = (mensaje) => {
                if (errorEl) {
                    errorEl.textContent = mensaje;
                    errorEl.classList.remove("hidden");
                    errorEl.scrollIntoView({ behavior: "smooth", block: "center" });
                }
            };

            if (errorEl) errorEl.classList.add("hidden");

            const nombre = document.getElementById("input-nombre").value.trim();
            const apellido = document
                .getElementById("input-apellido")
                .value.trim();
            const rut = document.getElementById("input-rut").value.trim();
            const correo = document.getElementById("input-correo").value.trim();
            const telefono = document
                .getElementById("input-telefono")
                .value.trim();
            const comuna = document.getElementById("input-comuna").value.trim();
            const region = document
                .getElementById("select-region")
                .value.trim();
            const direccion = document
                .getElementById("input-direccion")
                .value.trim();
            const paisEl = document.getElementById("input-pais");
            const ciudadEl = document.getElementById("input-ciudad");
            const pais = paisEl ? paisEl.value.trim() : "";
            const ciudad = ciudadEl ? ciudadEl.value.trim() : "";
            const metodo_pago = document.getElementById("select-pago").value;
            const tipoEntregaEl = document.querySelector(
                'input[name="tipo_entrega"]:checked',
            );

            // Validación de campos visibles (P0-3): un mensaje específico por cada regla
            if (!state.set) {
                mostrarError("Selecciona un producto.");
                return;
            }
            if (!state.envio) {
                mostrarError("Selecciona una modalidad de envío.");
                return;
            }
            if (state.envio === "internacional") {
                // Despacho internacional: no exige tipo_entrega ni datos
                // chilenos, solo país/ciudad para poder cotizar.
                if (!pais) {
                    mostrarError("Selecciona el país de destino.");
                    return;
                }
                if (!ciudad) {
                    mostrarError("Ingresa la ciudad de destino.");
                    return;
                }
            } else {
                if (!tipoEntregaEl) {
                    mostrarError(
                        state.envio === "retiro"
                            ? "Selecciona una modalidad de retiro."
                            : "Selecciona si deseas recibir en domicilio o en sucursal.",
                    );
                    return;
                }
                if (state.envio !== "retiro") {
                    if (!region || !comuna) {
                        mostrarError("Selecciona región y comuna.");
                        return;
                    }
                    if (tipoEntregaEl.value === "domicilio" && !direccion) {
                        mostrarError("Ingresa la dirección de entrega.");
                        return;
                    }
                }
            }
            if (!nombre || !apellido || !rut || !correo || !telefono) {
                mostrarError("Completa tus datos de contacto.");
                return;
            }
            const correoValido = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo);
            if (!correoValido) {
                mostrarError("Ingresa un correo electrónico válido.");
                return;
            }
            if (!metodo_pago) {
                mostrarError("Selecciona un método de pago.");
                return;
            }

            // Deshabilitar botón (Bloqueo Anti-Doble Clic)
            btn.disabled = true;
            btn.innerHTML = "⏳ Procesando pedido...";

            const tipoSetStr = state.set;
            const total = state.precioBase + state.precioMascota + state.costoCaja;

            let envioStr = "";
            if (state.envio === "starken") envioStr = "starken";
            else if (state.envio === "chilexpress") envioStr = "chilexpress";
            else if (state.envio === "internacional") envioStr = "internacional";
            else envioStr = "retiro";

            // Canal de pago real (única fuente de verdad, reutilizada abajo
            // para Sheets y para decidir qué bloque de pago mostrar).
            const canalPago = obtenerCanalPago(metodo_pago);

            // =========================================
            // 🚀 EL NUEVO PUENTE HACIA GOOGLE SHEETS
            // =========================================
            // La hoja de Google Sheets todavía no tiene una columna dedicada
            // para la mascota. Para no romper el esquema actual, se agrega
            // dentro del mismo campo "tipo_set" que ya existe (campo de
            // producto/pedido), como "<Set> + <Mascota>". Sin mascota, el
            // campo queda igual que antes (solo el nombre del set).
            const tipoSetParaSheets = state.mascota
                ? `${state.set} + ${state.mascota}`
                : state.set;

            // El método de pago registrado en Sheets refleja el canal real
            // (lo que efectivamente ve/hace el cliente), no solo el valor
            // crudo del <select>, para no perder trazabilidad de los casos
            // en que Flow no pudo usarse directamente.
            const metodoPagoParaSheets = {
                internacional: "Coordinación por WhatsApp - despacho internacional",
                chilexpress: "Coordinación por WhatsApp - Chilexpress",
                "flow-sin-enlace":
                    "Coordinación por WhatsApp - Flow no disponible",
                "flow-pedido-combinado":
                    "Coordinación por WhatsApp - pedido combinado",
                "flow-directo": "Link de Pago (Flow)",
                transferencia: "Transferencia Bancaria",
            }[canalPago];

            // El esquema de Sheets no cambia: para pedidos internacionales
            // se reutilizan los mismos campos region/comuna/direccion con
            // país/ciudad (y dirección vacía), en vez de agregar columnas.
            const regionParaSheets =
                state.envio === "internacional" ? pais : region;
            const comunaParaSheets =
                state.envio === "internacional" ? ciudad : comuna;
            const direccionParaSheets =
                state.envio === "internacional" ? "" : direccion;

            const formData = new FormData();
            formData.append("nombre", nombre);
            formData.append("apellido", apellido);
            formData.append("rut", rut);
            formData.append("correo", correo);
            formData.append("telefono", telefono);
            formData.append("region", regionParaSheets);
            formData.append("comuna", comunaParaSheets);
            formData.append("direccion", direccionParaSheets);
            formData.append("metodo_pago", metodoPagoParaSheets);
            formData.append("tipo_set", tipoSetParaSheets);
            formData.append("metodo_envio", envioStr);

            const scriptURL =
                "https://script.google.com/macros/s/AKfycbwfot7dNP3mb2nGjSeNJ0iR616MaNGnNvO0EbtKube_xnqggzCPAcEPRtzzkJaHGi6H/exec";

            fetch(scriptURL, {
                method: "POST",
                body: formData,
                mode: "no-cors", // Evita bloqueos de seguridad del navegador
            })
                .then(() => {
                    // El fetch usa modo "no-cors": el navegador no puede leer la
                    // respuesta del servidor, por lo que no podemos afirmar que
                    // Google Sheets recibió o guardó los datos correctamente.
                    console.warn(
                        "La solicitud fue enviada en modo no-cors; la respuesta del servidor no puede verificarse desde el navegador.",
                    );
                    btn.classList.remove(
                        "bg-terapia-sage",
                        "hover:bg-terapia-sageDark",
                    );
                    btn.classList.add("bg-green-800", "hover:bg-green-900");
                    btn.innerHTML =
                        "✅ Solicitud enviada. Continúa al pago y confirma tu pedido por WhatsApp.";

                    setTimeout(() => {
                        // Ocultar formulario
                        const formContent =
                            document.getElementById("datos-form-content");
                        if (formContent) formContent.classList.add("hidden");

                        // Mostrar pantalla pago
                        const pantallaPago =
                            document.getElementById("pantalla-pago");
                        if (pantallaPago)
                            pantallaPago.classList.remove("hidden");

                        const whatsappUrl = obtenerUrlWhatsApp();

                        // Ocultar todos los bloques de pago antes de mostrar el que
                        // corresponde: nunca deben quedar dos bloques visibles a la vez.
                        const bloqueFlow = document.getElementById("bloque-flow");
                        const bloqueTransferencia = document.getElementById(
                            "bloque-transferencia",
                        );
                        const bloqueChilexpress = document.getElementById(
                            "bloque-chilexpress",
                        );
                        const bloqueCoordinacion = document.getElementById(
                            "bloque-coordinacion-whatsapp",
                        );
                        const bloqueInternacional = document.getElementById(
                            "bloque-internacional",
                        );
                        [
                            bloqueFlow,
                            bloqueTransferencia,
                            bloqueChilexpress,
                            bloqueCoordinacion,
                            bloqueInternacional,
                        ].forEach((bloque) => bloque && bloque.classList.add("hidden"));

                        // Único punto que asigna currentFlowUrl: no depende de que
                        // cada rama recuerde limpiarla. Solo "flow-directo" recibe
                        // una URL real; cualquier otro canal la deja vacía, así no
                        // puede quedar un enlace residual de una selección anterior.
                        currentFlowUrl =
                            canalPago === "flow-directo"
                                ? flowLinks[state.set]
                                : "";

                        // Prioridad: Internacional > Chilexpress > Flow inválido (sin
                        // enlace o con mascota) > Flow válido > Transferencia. Un
                        // enlace Flow solo se abre cuando cobra exactamente el total
                        // mostrado; un pedido internacional nunca abre Flow.
                        if (canalPago === "internacional") {
                            if (bloqueInternacional)
                                bloqueInternacional.classList.remove("hidden");
                            document.getElementById(
                                "btn-whatsapp-internacional",
                            ).href = whatsappUrl;
                        } else if (canalPago === "chilexpress") {
                            if (bloqueChilexpress)
                                bloqueChilexpress.classList.remove("hidden");
                            document.getElementById(
                                "btn-whatsapp-chilexpress",
                            ).href = whatsappUrl;
                        } else if (
                            canalPago === "flow-sin-enlace" ||
                            canalPago === "flow-pedido-combinado"
                        ) {
                            const textoCoordinacion = document.getElementById(
                                "texto-coordinacion-pago",
                            );
                            if (textoCoordinacion) {
                                textoCoordinacion.textContent =
                                    canalPago === "flow-sin-enlace"
                                        ? "Este set todavía no cuenta con un enlace de pago Flow habilitado. Coordinaremos el pago directamente por WhatsApp."
                                        : "Tu pedido incluye una mascota y no existe un enlace Flow configurado por el total completo. Coordinaremos el pago directamente por WhatsApp para evitar un cobro incompleto.";
                            }
                            if (bloqueCoordinacion)
                                bloqueCoordinacion.classList.remove("hidden");
                            document.getElementById(
                                "btn-whatsapp-coordinacion",
                            ).href = whatsappUrl;
                        } else if (canalPago === "flow-directo") {
                            if (bloqueFlow) bloqueFlow.classList.remove("hidden");
                            document.getElementById("btn-whatsapp-flow").href =
                                whatsappUrl;
                        } else {
                            if (bloqueTransferencia)
                                bloqueTransferencia.classList.remove("hidden");
                            document.getElementById(
                                "btn-whatsapp-transferencia",
                            ).href = whatsappUrl;
                        }
                    }, 1500); // Transición suave después de 1.5s
                })
                .catch((error) => {
                    console.error(
                        "❌ No fue posible enviar los datos del pedido:",
                        error,
                    );
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                    mostrarError(
                        "No fue posible enviar tus datos automáticamente. Continúa por WhatsApp para confirmar tu pedido.",
                    );
                    // Fallback: si falla el envío a Sheets, igual abrimos WhatsApp para no perder al cliente.
                    // Esto NO significa que el pedido haya quedado registrado.
                    window.open(obtenerUrlWhatsApp(), "_blank");
                });
            // =========================================

            function obtenerUrlWhatsApp() {
                // Captura el valor y la etiqueta del radio button seleccionado:
                const tipoEntregaValor = tipoEntregaEl?.value || "";
                const tipoEntrega =
                    tipoEntregaEl?.nextElementSibling.innerText ||
                    "No especificado";

                // Construir el mensaje de WhatsApp para Famores
                let envioVisual = "";
                if (state.envio === "starken")
                    envioVisual = "Starken (Envío por pagar)";
                else if (state.envio === "chilexpress")
                    envioVisual = "Chilexpress";
                else if (state.envio === "internacional")
                    envioVisual = "Despacho Internacional";
                else envioVisual = "Retiro Presencial";

                // Región/Comuna solo aplican a envíos nacionales por courier
                // (Starken/Chilexpress). Ni retiro ni internacional los usan
                // (internacional usa País/Ciudad, armado aparte más abajo).
                let datosUbicacion = "";
                if (state.envio !== "retiro" && state.envio !== "internacional") {
                    datosUbicacion = `\n- Región: ${region || "Pendiente"}\n- Comuna: ${comuna || "Pendiente"}`;
                    if (tipoEntregaValor === "domicilio") {
                        datosUbicacion += `\n- Dirección: ${direccion || "Pendiente"}`;
                    }
                }

                let saludoInicial = "";
                if (canalPago === "internacional") {
                    saludoInicial =
                        "¡Hola Famores! Vengo desde la página web. Quiero solicitar un despacho internacional y necesito cotizar el envío antes de realizar el pago.";
                } else if (canalPago === "chilexpress") {
                    saludoInicial =
                        "¡Hola Famores! Vengo de la página web. Quedo a la espera de la cotización del despacho por Chilexpress y del total final antes de realizar el pago.";
                } else if (canalPago === "flow-sin-enlace") {
                    // Documentación del bloqueo: este set todavía no tiene link de Flow
                    // habilitado, por lo que no correspondía decir "abrí el enlace de Flow".
                    saludoInicial =
                        "¡Hola Famores! Vengo desde la página web. Quiero encargar el Set Standard con Expresiones. Sé que este set aún no tiene link de pago Flow habilitado y quedo a la espera de coordinar el pago contigo directamente por WhatsApp.";
                } else if (canalPago === "flow-pedido-combinado") {
                    // El set sí tiene enlace Flow, pero ese enlace cobra un monto fijo
                    // que no incluye la mascota agregada: coordinación manual explícita.
                    saludoInicial =
                        "¡Hola Famores! Vengo desde la página web. Mi pedido incluye un set y una mascota, por lo que necesito coordinar por WhatsApp el pago del total completo.";
                } else if (canalPago === "transferencia") {
                    saludoInicial =
                        "¡Hola Famores! Vengo desde la página web. Realicé una transferencia y adjunto el comprobante para su verificación.";
                } else {
                    // Link de Pago (Flow) directo y válido: el sitio solo abrió el
                    // enlace de pago, no puede confirmar que el pago fue aprobado (no
                    // hay integración con la API/webhook de Flow todavía).
                    saludoInicial =
                        "¡Hola Famores! Vengo desde la página web. Abrí el enlace de pago de Flow. Mi pedido queda pendiente de verificación.";
                }

                let notaFinal = "";
                if (state.envio === "starken") {
                    notaFinal = `\n\n*Nota:* Recuerda que el costo del envío es "Por Pagar" al momento de recibir tu paquete.`;
                } else if (state.envio === "retiro") {
                    notaFinal = `\n\n*Nota:* Retiro en ${DIRECCION_RETIRO}.`;
                }

                // Línea de mascota independiente: solo aparece si se agregó una.
                // No reemplaza ni se mezcla con el nombre del set (tipoSetStr).
                const lineaMascota = state.mascota
                    ? `\n- *Mascota:* ${state.mascota}`
                    : "";

                // El despacho internacional no lleva región/comuna/dirección
                // chilena ni "Modalidad de Entrega" (no existe tipo_entrega
                // en ese flujo): en su lugar muestra País/Ciudad y la nota
                // de cotización pendiente, tal como pide el formato acordado.
                const mensaje =
                    state.envio === "internacional"
                        ? `${saludoInicial}

Quiero encargar mis Famores:

- *Pedido:* ${tipoSetStr}${lineaMascota}
- *Total del pedido:* $${total.toLocaleString("es-CL")}
- *Entrega:* Despacho Internacional
- *País:* ${pais || "Pendiente"}
- *Ciudad:* ${ciudad || "Pendiente"}

*Nota:* Despacho internacional pendiente de cotización. El total indicado no incluye envío, courier, impuestos, aduanas ni otros cargos asociados.

*Mis Datos:*
- Nombre: ${nombre} ${apellido}
- Rut: ${rut}
- Correo: ${correo}
- Teléfono: ${telefono}

¡Espero mis Famores!`
                        : `${saludoInicial}

Quiero encargar mis Famores:

- *Pedido:* ${tipoSetStr}${lineaMascota}
- *Total del pedido:* $${total.toLocaleString("es-CL")}
- *Envío preferido:* ${envioVisual}
- *Método de Pago:* ${metodo_pago}

*Mis Datos:*
- Nombre: ${nombre} ${apellido}
- Rut: ${rut}
- Correo: ${correo}
- Teléfono: ${telefono}${datosUbicacion}
• Modalidad de Entrega: ${tipoEntrega}

¡Espero mis Famores!${notaFinal}`;

                const mensajeCodificado = encodeURIComponent(mensaje);

                // 🔥 MI NÚMERO DE PRUEBAS
                const numeroFamores = "56962052499"; // Reemplazaré esto manualmente por mi celular real

                return `https://wa.me/${numeroFamores}?text=${mensajeCodificado}`;
            }
        }

        // Variables y Funciones para Checkout UX
        let currentFlowUrl = "";

        function volverAFormulario() {
            document.getElementById("pantalla-pago").classList.add("hidden");
            document
                .getElementById("datos-form-content")
                .classList.remove("hidden");

            // Restablecer el botón principal
            const btn =
                document.getElementById("btn-submit-main") ||
                document.querySelector('button[onclick="generarWhatsApp()"]');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = `Confirmar Pedido y Continuar al Pago <i class="fa-solid fa-arrow-right ml-2"></i>`;
                btn.classList.remove("bg-green-800", "hover:bg-green-900");
                btn.classList.add(
                    "bg-terapia-sage",
                    "hover:bg-terapia-sageDark",
                );
            }

            // Ocultar bloques de pago
            document.getElementById("bloque-flow").classList.add("hidden");
            document
                .getElementById("bloque-transferencia")
                .classList.add("hidden");
            const bloqueChilexpress =
                document.getElementById("bloque-chilexpress");
            if (bloqueChilexpress) bloqueChilexpress.classList.add("hidden");
            const bloqueCoordinacion = document.getElementById(
                "bloque-coordinacion-whatsapp",
            );
            if (bloqueCoordinacion) bloqueCoordinacion.classList.add("hidden");
            const bloqueInternacional = document.getElementById(
                "bloque-internacional",
            );
            if (bloqueInternacional) bloqueInternacional.classList.add("hidden");

            // Resetear estados de botones internos
            document.getElementById("btn-pago-flow").classList.remove("hidden");
            document
                .getElementById("btn-whatsapp-flow")
                .classList.add("hidden");

            // El pedido va a editarse: cualquier enlace Flow calculado para
            // la selección anterior queda inválido hasta que se regenere.
            currentFlowUrl = "";
        }

        function iniciarPagoFlow() {
            // No confiar solo en currentFlowUrl: se recalcula el canal y el
            // enlace en el momento del clic, para blindar contra cualquier
            // residuo de una selección anterior (p. ej. si el set o la
            // mascota cambiaron después de generar el pedido sin volver a
            // pasar por el formulario).
            const metodoPagoActual =
                document.getElementById("select-pago")?.value || "";
            const canalActual = obtenerCanalPago(metodoPagoActual);
            const urlOficial = flowLinks[state.set];

            const esFlowDirectoValido =
                canalActual === "flow-directo" &&
                Boolean(state.set) &&
                !state.mascota &&
                Boolean(urlOficial) &&
                urlOficial === flowLinks[state.set];

            if (!esFlowDirectoValido) {
                // El estado actual ya no corresponde a un Flow directo
                // válido: no se abre ninguna URL (ni la almacenada ni una
                // improvisada) y se limpia cualquier residual.
                currentFlowUrl = "";
                console.warn(
                    "Pago con Flow bloqueado: el pedido actual ya no corresponde a un enlace Flow directo válido (mascota agregada, set sin enlace, envío Chilexpress o método de pago distinto). La coordinación por WhatsApp sigue disponible.",
                );
                return;
            }

            // Se deriva la URL desde flowLinks[state.set] en este mismo
            // instante; nunca se abre a partir de un valor guardado sin
            // volver a validarlo.
            currentFlowUrl = urlOficial;
            window.open(currentFlowUrl, "_blank");
            document.getElementById("btn-pago-flow").classList.add("hidden");
            document
                .getElementById("btn-whatsapp-flow")
                .classList.remove("hidden");
        }

        document.addEventListener("DOMContentLoaded", () => {
            // Accesibilidad mínima: permitir seleccionar con teclado las tarjetas
            // que todavía son <div> con onclick (envío). Las tarjetas de producto
            // ya son <button> reales y no necesitan este refuerzo.
            document.querySelectorAll(".option-card").forEach((card) => {
                if (card.tagName === "BUTTON") return;
                card.setAttribute("tabindex", "0");
                card.setAttribute("role", "button");
                card.addEventListener("keydown", (e) => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        card.click();
                    }
                });
            });
        });

        document.addEventListener("DOMContentLoaded", () => {
            const btnCopiar = document.getElementById("btn-copiar-datos");
            if (btnCopiar) {
                btnCopiar.addEventListener("click", () => {
                    const textoCopiar = `Nombre: Famores\nRUT: 13687247-8\nBanco: Santander\nTipo: Cuenta Corriente\nN° Cuenta: 68370043\nEmail: famoresporelmundo@gmail.com`;

                    navigator.clipboard
                        .writeText(textoCopiar)
                        .then(() => {
                            const originalHtml = btnCopiar.innerHTML;
                            btnCopiar.innerHTML = "✅ ¡Datos copiados!";
                            setTimeout(() => {
                                btnCopiar.innerHTML = originalHtml;
                            }, 2000);
                        })
                        .catch((err) => {
                            console.error(
                                "Error al copiar al portapapeles: ",
                                err,
                            );
                        });
                });
            }
        });
    </script>
</Layout>
