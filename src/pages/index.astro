---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Set from '../components/Set.astro';
import Modalidad from '../components/Modalidad.astro';
import Datos from '../components/Datos.astro';
---

<Layout title="Cotizador FAMORES">
    <div class="max-w-3xl mx-auto space-y-8">
        <Hero />
        <Set />
        <Modalidad />
        <Datos />       

    </div>

    <script is:inline>
        // Variables de estado
        let state = {
            set: null,
            precioBase: 0,
            envio: null,
            costoCaja: 0
        };

        // Función cuando seleccionan un Set
        function selectSet(tipo, precio) {
            state.set = tipo;
            state.precioBase = precio;

            // Cambiar estilos visuales
            document.getElementById('card-pintado').classList.remove('selected');
            document.getElementById('card-sin-pintar').classList.remove('selected');
            
            if(tipo === 'pintado') {
                document.getElementById('card-pintado').classList.add('selected');
            } else {
                document.getElementById('card-sin-pintar').classList.add('selected');
            }

            // Habilitar la sección de envío
            let seccionEnvio = document.getElementById('section-envio');
            seccionEnvio.classList.remove('opacity-50', 'pointer-events-none');
            
            actualizarResumen();
        }

        // Función cuando seleccionan Método de Envío
        function selectShipping(metodo) {
            state.envio = metodo;
            
            // Si es chilexpress, sumamos la caja
            state.costoCaja = (metodo === 'chilexpress') ? 1500 : 0;

            // Cambiar estilos visuales
            document.getElementById('card-starken').classList.remove('selected');
            document.getElementById('card-chilexpress').classList.remove('selected');
            document.getElementById('card-retiro').classList.remove('selected');
            
            document.getElementById(`card-${metodo}`).classList.add('selected');

            // Mostrar u ocultar Región/Comuna dependiendo de si es retiro
            const containerRC = document.getElementById('container-region-comuna');
            if(containerRC) {
                if (metodo === 'retiro') {
                    containerRC.classList.add('hidden');
                } else {
                    containerRC.classList.remove('hidden');
                }
            }

            // Mostrar el formulario final
            document.getElementById('section-datos').classList.remove('hidden');
            
            actualizarResumen();
        }

        // Actualizar los textos y matemáticas del resumen
        function actualizarResumen() {
            if(!state.set || !state.envio) return;

            const nombreSet = state.set === 'pintado' ? 'Set Pintado (14 figuras)' : 'Set Sin Pintar (14 figuras)';
            document.getElementById('resumen-producto').innerText = nombreSet;
            document.getElementById('resumen-precio').innerText = `$${state.precioBase.toLocaleString('es-CL')}`;

            const rowCaja = document.getElementById('resumen-caja-row');
            const notaEnvio = document.getElementById('resumen-nota-envio');

            if(state.envio === 'chilexpress') {
                rowCaja.classList.remove('hidden');
                notaEnvio.innerText = "* Nota: Katherine despachará y luego te enviará el comprobante de Chilexpress para que le transfieras el valor exacto del envío.";
            } else if(state.envio === 'starken') {
                rowCaja.classList.add('hidden');
                notaEnvio.innerText = "* Nota: Pagarás el envío directamente a Starken cuando recibas tu paquete.";
            } else {
                rowCaja.classList.add('hidden');
                notaEnvio.innerText = "* Nota: Katherine se pondrá en contacto contigo para coordinar la entrega en Metro Grecia.";
            }

            const total = state.precioBase + state.costoCaja;
            document.getElementById('resumen-total').innerText = `$${total.toLocaleString('es-CL')}`;
        }

       // Función que genera el mensaje, envía datos a Python y abre WhatsApp
        function generarWhatsApp() {
            const btn = document.querySelector('button[onclick="generarWhatsApp()"]');
            const originalText = btn.innerHTML;

            const nombre = document.getElementById('input-nombre').value.trim();
            const apellido = document.getElementById('input-apellido').value.trim();
            const rut = document.getElementById('input-rut').value.trim();
            const correo = document.getElementById('input-correo').value.trim();
            const telefono = document.getElementById('input-telefono').value.trim();
            const comuna = document.getElementById('input-comuna').value.trim();
            const region = document.getElementById('select-region').value.trim();
            const direccion = document.getElementById('input-direccion').value.trim();
            const metodo_pago = document.getElementById('select-pago').value;

            if(!nombre || !apellido || !rut || !correo || !telefono) {
                btn.innerHTML = "⚠️ ¡Faltan tus datos!";
                btn.classList.add('bg-red-500');
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.classList.remove('bg-red-500');
                }, 2000);
                return;
            }

            // Deshabilitar botón (Bloqueo Anti-Doble Clic)
            btn.disabled = true;
            btn.innerHTML = "⏳ Procesando pedido...";

            const tipoSetStr = state.set === 'pintado' ? 'Pintado' : 'Sin Pintar';
            const total = state.precioBase + state.costoCaja;
            
            let envioStr = "";
            if(state.envio === 'starken') envioStr = "starken";
            else if(state.envio === 'chilexpress') envioStr = "chilexpress";
            else envioStr = "retiro";

            // =========================================
            // 🚀 EL NUEVO PUENTE HACIA GOOGLE SHEETS
            // =========================================
            const formData = new FormData();
            formData.append('nombre', nombre);
            formData.append('apellido', apellido);
            formData.append('rut', rut);
            formData.append('correo', correo);
            formData.append('telefono', telefono);
            formData.append('region', region);
            formData.append('comuna', comuna);
            formData.append('direccion', direccion);
            formData.append('metodo_pago', metodo_pago);
            formData.append('tipo_set', state.set);
            formData.append('metodo_envio', envioStr);

            const scriptURL = 'https://script.google.com/macros/s/AKfycbwz5uFrlCdFM6gTntEIo0Rvry_LSKFzyb1d_EVm8VuKU1QGxcmBGx9MqhZhk15edKmvLA/exec';

            fetch(scriptURL, { 
                method: 'POST', 
                body: formData,
                mode: 'no-cors' // Evita bloqueos de seguridad del navegador
            }).then(() => {
                console.log("✅ Datos guardados en Excel y enviados al correo.");
                // Pantalla de Éxito
                btn.classList.remove('bg-[#25D366]', 'hover:bg-[#1DA851]');
                btn.classList.add('bg-green-800', 'hover:bg-green-900');
                btn.innerHTML = "✅ ¡Pedido registrado con éxito! Tu orden está en proceso";
                
                setTimeout(() => {
                    continuarWhatsApp();
                }, 1500); // Redirigir a WhatsApp después de 1.5s
            }).catch(error => {
                console.error("❌ Error conectando con Google:", error);
                btn.disabled = false;
                btn.innerHTML = originalText;
                continuarWhatsApp();
            });
            // =========================================

            function continuarWhatsApp() {
                // Construir el mensaje de WhatsApp para Katherine
                let envioVisual = "";
                if(state.envio === 'starken') envioVisual = "Starken (Envío por pagar)";
                else if(state.envio === 'chilexpress') envioVisual = "Chilexpress";
                else envioVisual = "Retiro Presencial (Metro Grecia)";

                let datosUbicacion = "";
                if (state.envio !== 'retiro') {
                    datosUbicacion = `\n📍 Región: ${region || 'Pendiente'}\n📍 Comuna: ${comuna || 'Pendiente'}\n📍 Dirección: ${direccion || 'Pendiente'}`;
                }

                const mensaje = `¡Hola Katherine! 👋 vengo desde la página web.\n\nQuiero encargar mis Famores:\n\n*Pedido:* Set ${tipoSetStr}\n*Total a transferir hoy:* $${total.toLocaleString('es-CL')}\n*Envío preferido:* ${envioVisual}\n*Método de Pago:* ${metodo_pago}\n\n*Mis Datos:*\n👤 Nombre: ${nombre} ${apellido}\n🆔 Rut: ${rut}\n📧 Correo: ${correo}\n📱 Teléfono: ${telefono}${datosUbicacion}\n\nQuedo atenta a tus datos de transferencia para confirmar. ✨`;

                const mensajeCodificado = encodeURIComponent(mensaje);
                
                // 🔥 MI NÚMERO DE PRUEBAS
                const numeroKatherine = "56958083908"; // Reemplazaré esto manualmente por mi celular real
                
                const urlWhatsApp = `https://wa.me/${numeroKatherine}?text=${mensajeCodificado}`;
                
                // Redirigir al cliente a WhatsApp
                window.open(urlWhatsApp, '_blank');
            }
        }
    </script>
</Layout>
