---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Set from "../components/Set.astro";
import ComposicionSet from "../components/ComposicionSet.astro";
---

<Layout title="Famores">
    <main id="contenido-principal">
        <Hero />
        <Set />
        <ComposicionSet />

        <section class="max-w-4xl mx-auto px-4 pb-16 text-center">
            <div class="rounded-2xl bg-white border border-stone-100 shadow-sm px-6 py-8">
                <h2 class="text-2xl font-bold text-terapia-text">¿Listo para armar tu pedido?</h2>
                <p class="text-gray-500 mt-3">
                    Elige productos y cantidades en el carrito de compra.
                </p>
                <a
                    href="/comprar"
                    class="mt-5 inline-flex min-h-[48px] items-center justify-center gap-2 rounded-xl bg-terapia-sageDark text-white font-semibold py-3 px-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terapia-sageDark"
                >
                    Ir al carrito <i class="fa-solid fa-cart-shopping text-xs"></i>
                </a>
            </div>
        </section>
    </main>
</Layout>
