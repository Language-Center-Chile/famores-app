---
import Layout from "../layouts/Layout.astro";
import { communesByRegion, regions } from "../data/chile-communes";

const products = [
  { slug: "set-standard-pintado", name: "Set Standard Pintado", price: 39990, image: "/images/products/set-standard-pintado.webp" },
  { slug: "set-standard-con-expresiones", name: "Set Standard con Expresiones", price: 42990, image: "/images/products/set-standard-con-expresiones.webp" },
  { slug: "set-sin-pintar", name: "Set Sin Pintar", price: 25000, image: "/images/products/set-sin-pintar-1.jpg" },
  { slug: "set-personalizado", name: "Set Personalizado", price: 45000, image: "/images/products/set-personalizado-aymara.webp" },
  { slug: "mascota-pintada", name: "Mascota Pintada", price: 4500, image: "/images/products/mascota-pintada-2.jpg" },
  { slug: "mascota-sin-pintar", name: "Mascota Sin Pintar", price: 2500, image: "/images/products/mascota-sin-pintar-1.jpg" },
];
---

<Layout title="Comprar Famores">
  <main id="contenido-principal" class="max-w-6xl mx-auto px-0 sm:px-4 py-4 sm:py-10 md:py-16 overflow-x-hidden">
    <header class="max-w-3xl mb-7 sm:mb-10">
      <a href="/" class="inline-flex min-h-[44px] items-center text-sm font-semibold text-terapia-sageDark hover:underline">← Volver a Famores</a>
      <h1 class="text-3xl md:text-4xl font-bold text-terapia-text mt-2 sm:mt-4">Arma tu pedido</h1>
      <p class="text-gray-600 mt-3">Compra el producto que quieras, combina productos y agrega varias unidades.</p>
    </header>

    <div class="grid lg:grid-cols-[1.5fr_0.9fr] gap-6 lg:gap-8 items-start min-w-0">
      <section class="min-w-0" aria-labelledby="productos-heading">
        <h2 id="productos-heading" class="text-xl font-bold text-terapia-text mb-4">Productos</h2>
        <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
          {products.map((product) => (
            <article class="rounded-2xl bg-white border-2 border-stone-100 shadow-sm overflow-hidden min-w-0 transition-all duration-200" data-product={product.name} data-slug={product.slug} data-price={product.price}>
              <div class="aspect-[4/3] bg-terapia-bg flex items-center justify-center overflow-hidden relative">
                <img src={product.image} alt={product.name} class="w-full h-full object-contain" loading="lazy" />
                <span class="selected-badge hidden absolute top-3 right-3 rounded-full bg-terapia-sageDark text-white text-xs font-bold px-3 py-1.5 shadow-sm">✓ Seleccionado</span>
              </div>
              <div class="p-4 sm:p-5">
                <h3 class="font-semibold text-lg text-terapia-text break-words">{product.name}</h3>
                <p class="font-bold text-xl text-terapia-sageDark mt-1">${product.price.toLocaleString("es-CL")}</p>
                <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                  <span class="text-sm font-medium text-gray-600">Cantidad</span>
                  <div class="flex items-center rounded-xl border border-stone-200 overflow-hidden" role="group" aria-label={`Cantidad de ${product.name}`}>
                    <button type="button" class="qty-minus min-w-[44px] min-h-[44px] px-3 font-bold" aria-label={`Quitar ${product.name}`}>−</button>
                    <input class="qty-input w-14 min-h-[44px] text-base text-center border-x border-stone-200 outline-none bg-white" type="number" inputmode="numeric" min="0" max="20" value="0" aria-label={`Cantidad de ${product.name}`} />
                    <button type="button" class="qty-plus min-w-[44px] min-h-[44px] px-3 font-bold" aria-label={`Agregar ${product.name}`}>+</button>
                  </div>
                </div>
                <button type="button" class="remove-product hidden mt-3 min-h-[40px] w-full rounded-xl border border-terapia-sageDark text-terapia-sageDark text-sm font-semibold px-3 py-2 hover:bg-terapia-bg" aria-label={`Quitar ${product.name} del pedido`}>Quitar del pedido</button>
              </div>
            </article>
          ))}
        </div>
      </section>

      <aside class="lg:sticky lg:top-5 rounded-2xl bg-white border border-stone-100 shadow-sm p-4 sm:p-6 min-w-0" aria-labelledby="carrito-heading">
        <h2 id="carrito-heading" class="text-xl font-bold text-terapia-text">Tu carrito</h2>
        <div id="cart-lines" class="mt-4 space-y-2 text-sm text-gray-700 min-w-0" aria-live="polite"><p>Aún no agregas productos.</p></div>

        <div class="border-t border-stone-200 mt-5 pt-5 space-y-3">
          <label class="block text-sm font-semibold text-terapia-text" for="delivery-type">Forma de entrega</label>
          <select id="delivery-type" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2 bg-white">
            <option value="pickup">Retiro presencial en local</option>
            <option value="home">Envío a domicilio</option>
            <option value="branch">Envío a sucursal</option>
            <option value="international">Envío internacional — cotización posterior</option>
          </select>

          <div id="courier-wrap" class="hidden space-y-2">
            <label class="block text-sm font-semibold text-terapia-text" for="courier">Transportista</label>
            <select id="courier" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2 bg-white">
              <option value="chilexpress">Chilexpress</option>
              <option value="starken">Starken</option>
            </select>
          </div>

          <div id="pickup-info" class="rounded-xl bg-terapia-bg border border-stone-200 px-4 py-3 text-sm text-gray-700">
            <strong class="block text-terapia-text">Retiro en local</strong>
            <span>Avenida Egaña 1638 B, Peñalolén, Santiago</span>
            <span class="block mt-1">A media cuadra del Metro Grecia.</span>
          </div>

          <div id="domestic-destination" class="hidden space-y-3">
            <label class="block text-sm font-semibold text-terapia-text" for="region">Región</label>
            <select id="region" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2 bg-white">
              <option value="">Selecciona región</option>
              {regions.map((region) => <option value={region}>{region}</option>)}
            </select>
            <label class="block text-sm font-semibold text-terapia-text" for="commune">Comuna</label>
            <select id="commune" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2 bg-white" disabled>
              <option value="">Selecciona primero una región</option>
            </select>
            <div id="home-address-fields" class="hidden space-y-3">
              <label class="block text-sm font-semibold text-terapia-text" for="delivery-address">Dirección de entrega</label>
              <input id="delivery-address" type="text" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2" placeholder="Calle, número, depto/casa" autocomplete="street-address" />
            </div>
            <div id="branch-fields" class="hidden space-y-3">
              <label class="block text-sm font-semibold text-terapia-text" for="branch-name">Sucursal de destino</label>
              <input id="branch-name" type="text" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2" placeholder="Nombre o dirección de la sucursal" />
              <p class="text-xs text-gray-500">Indica la sucursal de Chilexpress o Starken donde quieres retirar.</p>
            </div>
          </div>

          <div id="international-fields" class="hidden space-y-3 rounded-xl border border-stone-200 p-4">
            <div class="rounded-lg bg-terapia-bg px-3 py-3 text-sm text-gray-700">
              <strong class="block text-terapia-text">Despacho internacional por cotizar</strong>
              <span>Pagas ahora los productos y el embalaje. El costo de envío se cotiza después según país, ciudad, peso y transportista.</span>
            </div>
            <label class="block text-sm font-semibold text-terapia-text" for="country">País</label>
            <input id="country" type="text" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2" autocomplete="country-name" placeholder="Ej. Argentina" />
            <label class="block text-sm font-semibold text-terapia-text" for="city">Ciudad</label>
            <input id="city" type="text" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2" autocomplete="address-level2" placeholder="Ej. Mendoza" />
            <label class="block text-sm font-semibold text-terapia-text" for="international-address">Dirección</label>
            <input id="international-address" type="text" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2" autocomplete="street-address" placeholder="Calle, número, código postal" />
          </div>
        </div>

        <div class="border-t border-stone-200 mt-5 pt-5 space-y-3">
          <label class="block text-sm font-semibold text-terapia-text" for="customer-name">Nombre</label>
          <input id="customer-name" type="text" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2" autocomplete="given-name" />
          <label class="block text-sm font-semibold text-terapia-text" for="customer-lastname">Apellido</label>
          <input id="customer-lastname" type="text" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2" autocomplete="family-name" />
          <label class="block text-sm font-semibold text-terapia-text" for="customer-id">RUT / DNI</label>
          <input id="customer-id" type="text" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2" placeholder="Ej. 12.345.678-9 o documento extranjero" autocomplete="off" />
          <label class="block text-sm font-semibold text-terapia-text" for="customer-phone">Teléfono</label>
          <input id="customer-phone" type="tel" inputmode="tel" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2" placeholder="Ej. +56 9 1234 5678" autocomplete="tel" />
          <label class="block text-sm font-semibold text-terapia-text" for="customer-email">Correo</label>
          <input id="customer-email" type="email" inputmode="email" class="w-full min-h-[44px] text-base rounded-xl border border-stone-200 px-3 py-2" autocomplete="email" />
        </div>

        <div class="border-t border-stone-200 mt-5 pt-5 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><span>Entrega</span><strong id="delivery-summary" class="text-right">Retiro en local</strong></div>
          <div class="flex justify-between gap-3"><span>Productos</span><strong id="subtotal">$0</strong></div>
          <div class="flex justify-between gap-3"><span>Despacho</span><strong id="shipping">$0</strong></div>
          <div class="flex justify-between gap-3"><span>Caja</span><strong id="box">$0</strong></div>
          <div class="flex justify-between gap-3 text-lg pt-2"><span class="font-bold">Total a pagar ahora</span><strong id="total">$0</strong></div>
        </div>

        <p id="international-note" class="hidden mt-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 px-4 py-3 text-sm">El despacho internacional no está incluido en este total. Famores enviará la cotización del envío posteriormente.</p>
        <p id="cart-error" class="hidden mt-4 rounded-xl bg-red-50 text-red-700 px-4 py-3 text-sm" role="alert"></p>
        <button id="pay-button" type="button" class="w-full min-h-[48px] mt-5 rounded-xl bg-terapia-sage text-white font-bold py-3 px-4 disabled:opacity-50">Pagar con Flow</button>
        <p id="payment-note" class="text-xs text-gray-500 mt-3">El total se recalcula en el servidor antes de crear el pago.</p>
      </aside>
    </div>
  </main>

  <script id="communes-data" type="application/json" set:html={JSON.stringify(communesByRegion)}></script>
  <script is:inline>
    const money = (value) => `$${Number(value || 0).toLocaleString("es-CL")}`;
    const communesByRegion = JSON.parse(document.getElementById("communes-data").textContent || "{}");
    const cards = Array.from(document.querySelectorAll("[data-product]"));
    const deliveryTypeEl = document.getElementById("delivery-type");
    const courierWrapEl = document.getElementById("courier-wrap");
    const courierEl = document.getElementById("courier");
    const regionEl = document.getElementById("region");
    const communeEl = document.getElementById("commune");
    const domesticDestinationEl = document.getElementById("domestic-destination");
    const pickupInfoEl = document.getElementById("pickup-info");
    const homeAddressFieldsEl = document.getElementById("home-address-fields");
    const branchFieldsEl = document.getElementById("branch-fields");
    const internationalFieldsEl = document.getElementById("international-fields");
    const deliveryAddressEl = document.getElementById("delivery-address");
    const branchNameEl = document.getElementById("branch-name");
    const countryEl = document.getElementById("country");
    const cityEl = document.getElementById("city");
    const internationalAddressEl = document.getElementById("international-address");
    const internationalNoteEl = document.getElementById("international-note");
    const paymentNoteEl = document.getElementById("payment-note");
    const deliverySummaryEl = document.getElementById("delivery-summary");
    const errorEl = document.getElementById("cart-error");
    const payButton = document.getElementById("pay-button");
    let lastQuote = null;
    let quoteTimer = null;
    let quoteRequestId = 0;

    function updateCardState(card) {
      const quantity = Number(card.querySelector(".qty-input").value || 0);
      const selected = quantity > 0;
      card.classList.toggle("border-terapia-sageDark", selected);
      card.classList.toggle("ring-2", selected);
      card.classList.toggle("ring-terapia-sage", selected);
      card.classList.toggle("shadow-md", selected);
      card.classList.toggle("border-stone-100", !selected);
      card.querySelector(".selected-badge").classList.toggle("hidden", !selected);
      card.querySelector(".remove-product").classList.toggle("hidden", !selected);
    }

    function updateAllCardStates() { cards.forEach(updateCardState); }

    function getItems() {
      return cards.flatMap((card) => {
        const quantity = Number(card.querySelector(".qty-input").value || 0);
        return quantity > 0 ? [{ product: card.dataset.product, quantity }] : [];
      });
    }

    function effectiveCourier() {
      if (deliveryTypeEl.value === "pickup") return "retiro";
      if (deliveryTypeEl.value === "international") return "international";
      return courierEl.value;
    }

    function showError(message, target) {
      if (!message) { errorEl.classList.add("hidden"); errorEl.textContent = ""; return; }
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
      if (target) { target.scrollIntoView({ behavior: "smooth", block: "center" }); target.focus?.({ preventScroll: true }); }
    }

    function renderLines(items) {
      const container = document.getElementById("cart-lines");
      if (!items.length) { container.innerHTML = '<p>Aún no agregas productos.</p>'; return; }
      container.innerHTML = items.map((item) => `<div class="flex items-start justify-between gap-3"><span>${item.quantity} × ${item.product}</span><strong>${money(item.lineTotal)}</strong></div>`).join("");
    }

    function populateCommunes() {
      const communes = communesByRegion[regionEl.value] || [];
      communeEl.innerHTML = communes.length
        ? '<option value="">Selecciona comuna</option>' + communes.map((commune) => `<option value="${commune}">${commune}</option>`).join("")
        : '<option value="">Selecciona primero una región</option>';
      communeEl.disabled = communes.length === 0;
    }

    function updateDeliveryFields() {
      const deliveryType = deliveryTypeEl.value;
      const isPickup = deliveryType === "pickup";
      const isInternational = deliveryType === "international";
      const isDomestic = deliveryType === "home" || deliveryType === "branch";
      const isHome = deliveryType === "home";
      const isBranch = deliveryType === "branch";

      pickupInfoEl.classList.toggle("hidden", !isPickup);
      courierWrapEl.classList.toggle("hidden", !isDomestic);
      domesticDestinationEl.classList.toggle("hidden", !isDomestic);
      homeAddressFieldsEl.classList.toggle("hidden", !isHome);
      branchFieldsEl.classList.toggle("hidden", !isBranch);
      internationalFieldsEl.classList.toggle("hidden", !isInternational);
      internationalNoteEl.classList.toggle("hidden", !isInternational);

      if (isPickup) deliverySummaryEl.textContent = "Retiro en local";
      else if (isInternational) deliverySummaryEl.textContent = "Internacional — por cotizar";
      else deliverySummaryEl.textContent = `${isHome ? "Domicilio" : "Sucursal"} · ${courierEl.options[courierEl.selectedIndex]?.text || ""}`;

      payButton.textContent = isInternational ? "Pagar productos con Flow" : "Pagar con Flow";
      paymentNoteEl.textContent = isInternational
        ? "El despacho internacional se cotiza y cobra posteriormente."
        : "El total se recalcula en el servidor antes de crear el pago.";
    }

    async function refreshQuote() {
      const requestId = ++quoteRequestId;
      const items = getItems();
      updateAllCardStates();
      updateDeliveryFields();
      lastQuote = null;
      showError("");
      if (!items.length) {
        renderLines([]);
        ["subtotal","shipping","box","total"].forEach((id) => document.getElementById(id).textContent = "$0");
        payButton.disabled = false;
        return;
      }
      payButton.disabled = true;
      const courier = effectiveCourier();
      const region = regionEl.value.trim();
      const commune = communeEl.value.trim();
      const isDomestic = deliveryTypeEl.value === "home" || deliveryTypeEl.value === "branch";
      if (isDomestic && (!region || !commune)) {
        showError("Selecciona región y comuna para calcular el despacho.", !region ? regionEl : communeEl);
        return;
      }
      try {
        const response = await fetch("/api/cart/quote", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ items, courier, region, commune }) });
        const data = await response.json();
        if (requestId !== quoteRequestId) return;
        if (!response.ok) throw new Error(data.error || "No fue posible calcular el pedido.");
        lastQuote = data;
        renderLines(data.items);
        document.getElementById("subtotal").textContent = money(data.subtotal);
        document.getElementById("shipping").textContent = data.shippingPending ? "Por cotizar" : money(data.shippingPrice);
        document.getElementById("box").textContent = money(data.boxPrice);
        document.getElementById("total").textContent = money(data.total);
        payButton.disabled = false;
      } catch (error) {
        showError(error instanceof Error ? error.message : "No fue posible calcular el pedido.");
        payButton.disabled = false;
      }
    }

    function scheduleQuote() { clearTimeout(quoteTimer); quoteTimer = setTimeout(refreshQuote, 180); }
    cards.forEach((card) => {
      const input = card.querySelector(".qty-input");
      const syncSelection = () => { updateCardState(card); scheduleQuote(); };
      card.querySelector(".qty-minus").addEventListener("click", () => { input.value = String(Math.max(0, Number(input.value || 0) - 1)); syncSelection(); });
      card.querySelector(".qty-plus").addEventListener("click", () => { input.value = String(Math.min(20, Number(input.value || 0) + 1)); syncSelection(); });
      card.querySelector(".remove-product").addEventListener("click", () => { input.value = "0"; syncSelection(); });
      input.addEventListener("input", () => { input.value = String(Math.max(0, Math.min(20, Math.floor(Number(input.value || 0))))); syncSelection(); });
      input.addEventListener("focus", () => input.select());
    });

    deliveryTypeEl.addEventListener("change", () => { updateDeliveryFields(); scheduleQuote(); });
    courierEl.addEventListener("change", () => { updateDeliveryFields(); scheduleQuote(); });
    regionEl.addEventListener("change", () => { populateCommunes(); scheduleQuote(); });
    communeEl.addEventListener("change", scheduleQuote);

    payButton.addEventListener("click", async () => {
      const items = getItems();
      if (!items.length) return showError("Agrega al menos un producto al carrito.", cards[0]?.querySelector(".qty-plus") || cards[0]);
      if (!lastQuote) return refreshQuote();

      const nameEl = document.getElementById("customer-name");
      const lastNameEl = document.getElementById("customer-lastname");
      const idEl = document.getElementById("customer-id");
      const phoneEl = document.getElementById("customer-phone");
      const emailEl = document.getElementById("customer-email");
      const name = nameEl.value.trim();
      const lastName = lastNameEl.value.trim();
      const customerId = idEl.value.trim();
      const phone = phoneEl.value.trim();
      const email = emailEl.value.trim();
      const deliveryType = deliveryTypeEl.value;
      const courier = effectiveCourier();
      const country = countryEl.value.trim();
      const city = cityEl.value.trim();
      const deliveryAddress = deliveryType === "international" ? internationalAddressEl.value.trim() : deliveryAddressEl.value.trim();
      const branchName = branchNameEl.value.trim();
      const region = regionEl.value.trim();
      const commune = communeEl.value.trim();

      if (!name) return showError("Ingresa tu nombre.", nameEl);
      if (!lastName) return showError("Ingresa tu apellido.", lastNameEl);
      if (!customerId) return showError("Ingresa tu RUT o DNI.", idEl);
      if (phone.replace(/\D/g, "").length < 8) return showError("Ingresa un teléfono válido.", phoneEl);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError("Ingresa un correo válido.", emailEl);
      if ((deliveryType === "home" || deliveryType === "branch") && (!region || !commune)) return showError("Selecciona región y comuna.", !region ? regionEl : communeEl);
      if (deliveryType === "home" && !deliveryAddress) return showError("Ingresa la dirección de entrega.", deliveryAddressEl);
      if (deliveryType === "branch" && !branchName) return showError("Indica la sucursal de destino.", branchNameEl);
      if (deliveryType === "international" && !country) return showError("Ingresa el país de destino.", countryEl);
      if (deliveryType === "international" && !city) return showError("Ingresa la ciudad de destino.", cityEl);
      if (deliveryType === "international" && !deliveryAddress) return showError("Ingresa la dirección internacional.", internationalAddressEl);

      payButton.disabled = true;
      payButton.textContent = "Creando pago…";
      showError("");
      try {
        const response = await fetch("/api/flow/create-cart-payment", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ items, deliveryType, courier, region, commune, country, city, name, lastName, customerId, phone, email, deliveryAddress, branchName }),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "No fue posible crear el pago.");
        window.location.href = data.checkoutUrl;
      } catch (error) {
        showError(error instanceof Error ? error.message : "No fue posible crear el pago.");
        payButton.disabled = false;
        payButton.textContent = deliveryType === "international" ? "Pagar productos con Flow" : "Pagar con Flow";
      }
    });

    const preselected = new URLSearchParams(window.location.search).get("add");
    if (preselected) {
      const card = cards.find((candidate) => candidate.dataset.slug === preselected);
      if (card) card.querySelector(".qty-input").value = "1";
    }
    populateCommunes();
    updateDeliveryFields();
    updateAllCardStates();
    refreshQuote();
  </script>
</Layout>