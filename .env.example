# Flow: usar credenciales de SANDBOX durante QA.
# Nunca commitear valores reales en este archivo.
FLOW_API_KEY=replace_me
FLOW_SECRET_KEY=replace_me
FLOW_API_URL=https://sandbox.flow.cl/api

# URL pública del despliegue que Flow podrá llamar por POST.
# Ejemplo productivo: https://famores.com
PUBLIC_SITE_URL=https://your-public-domain.example

# Optional commerce module. Leave empty until a persistent volume is configured.
FAMORES_DB_PATH=
# JSON array: id, name, email, role (admin/seller), passwordHash (scrypt).
# No sample credentials; generate each hash with scripts/hash-password.mjs.
FAMORES_ACCOUNTS_JSON=[]
# Optional authenticated n8n workflow for email notifications (HTTPS only).
FAMORES_NOTIFICATION_WEBHOOK=
FAMORES_NOTIFICATION_TOKEN=
